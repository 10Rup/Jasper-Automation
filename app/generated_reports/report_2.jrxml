<pageHeader>
    <band height="240" splitType="Stretch">
        <image hAlign="Center" vAlign="Middle" onErrorType="Blank">
            <reportElement x="20" y="5" width="100" height="90"/>
            <imageExpression><![CDATA["university_logo.png"]]></imageExpression>
        </image>
        <staticText>
            <reportElement x="0" y="0" width="555" height="30" forecolor="#350EE6"/>
            <textElement textAlignment="Center" verticalAlignment="Middle">
                <font size="18" isBold="true"/>
            </textElement>
            <text><![CDATA[शहीद महेन्द्र कर्मा विश्वविद्यालय, बस्तर, जगदलपुर, छत्तीसगढ़]]></text>
        </staticText>
        <staticText>
            <reportElement x="0" y="30" width="555" height="20"/>
            <textElement textAlignment="Center" verticalAlignment="Middle">
                <font size="11" isBold="true"/>
            </textElement>
            <text><![CDATA[(Accredited by NAAC)]]></text>
        </staticText>
        <staticText>
            <reportElement x="0" y="50" width="555" height="20"/>
            <textElement textAlignment="Center" verticalAlignment="Middle">
                <font size="11" isBold="true"/>
            </textElement>
            <text><![CDATA[BACHELOR OF SCIENCE (HOME SCIENCE) FIRST SEMESTER EXAMINATION JULY-DEC-2025]]></text>
        </staticText>
        <staticText>
            <reportElement x="0" y="70" width="555" height="20"/>
            <textElement textAlignment="Center" verticalAlignment="Middle">
                <font size="11" isBold="true"/>
            </textElement>
            <text><![CDATA[SESSION : 2025-2026]]></text>
        </staticText>
        <staticText>
            <reportElement x="0" y="95" width="555" height="20"/>
            <textElement textAlignment="Center" verticalAlignment="Middle">
                <font size="12" isBold="true"/>
            </textElement>
            <text><![CDATA[Mark sheet Cum Grade Sheet]]></text>
        </staticText>
        <staticText>
            <reportElement x="30" y="125" width="100" height="15"/>
            <textElement textAlignment="Left" verticalAlignment="Middle">
                <font size="10" isBold="true"/>
            </textElement>
            <text><![CDATA[Status]]></text>
        </staticText>
        <textField isBlankWhenNull="true">
            <reportElement x="130" y="125" width="200" height="15"/>
            <textElement textAlignment="Left" verticalAlignment="Middle">
                <font size="10"/>
            </textElement>
            <textFieldExpression><![CDATA[": " + $F{STUDENTTYPE}]]></textFieldExpression>
        </textField>
        <staticText>
            <reportElement x="30" y="145" width="100" height="15"/>
            <textElement textAlignment="Left" verticalAlignment="Middle">
                <font size="10" isBold="true"/>
            </textElement>
            <text><![CDATA[Name of Student]]></text>
        </staticText>
        <textField isBlankWhenNull="true">
            <reportElement x="130" y="145" width="200" height="15"/>
            <textElement textAlignment="Left" verticalAlignment="Middle">
                <font size="10"/>
            </textElement>
            <textFieldExpression><![CDATA[": " + $F{STUDENTNAME}]]></textFieldExpression>
        </textField>
        <staticText>
            <reportElement x="30" y="165" width="100" height="15"/>
            <textElement textAlignment="Left" verticalAlignment="Middle">
                <font size="10" isBold="true"/>
            </textElement>
            <text><![CDATA[Father's Name]]></text>
        </staticText>
        <textField isBlankWhenNull="true">
