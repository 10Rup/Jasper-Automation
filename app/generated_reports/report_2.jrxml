<?xml version="1.0" encoding="UTF-8"?>
<!-- Created with Jaspersoft Studio version 6.8.0.final using JasperReports Library version 6.8.0-2ed8dfabb690ff337a5797129f2cd92902b0c87b  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1a3ec0e9-a736-460b-81a4-fa0e06798b78">
<queryString>
	<![CDATA[SELECT
TRM.THEAD1 AS EXAM_CODE,TRM.TOTALMARK AS "MAX MARKS",COURSETOTALCREDIT,TRCREDIT,
TRM.MIN_PASS_MARKS AS "MIN MARKS", TRM.MAINHEADER AS "EXAM NAME",IFNULL(TT.IS_DIVISION,"") AS "IS DIVISION",
TRM.FIRSTDIVISONMARK AS "FIRST DIVISION"  ,TRM.SECONDDIVISONMARK AS "SECOND DIVISION",
TT.THIRD_DIVISION AS "THIRD DIVISION", CM.COURSEDURATION AS "COURSE DURATION",TRM.MINSUBJECT AS "MIN.SUBJ.REQUIRED",
IFNULL(TT.IS_THEORY_AGRI,"N") AS "IS THEORY AGGREGATE",IFNULL(TT.IS_PRACTICAL_AGRI,"N") AS "IS PRACTICAL AGGREGATE", IFNULL(TT.IS_THEORY_GRACE,"N") AS "IS THEORY GRACE",IFNULL(TT.IS_PRACTICAL_GRACE,"N") AS "IS PRACTICAL GRACE",
TRM.PASSPERCENTAGE "MIN. PASS PER.AGGR.", TRM.PRACPASSPERCENTAGE AS "MIN. PASS PER.PRACT.AGGR.",IFNULL(TT.TOTAL_ATKT_SUBJECT,"") AS "TOTAL ATKT SUBJECTS",
TRM.MAXGRACE ,TT.IS_SUPPLY, TT.IS_GRACE, TT.IS_DIVISION_GRACE, TT.GRACE_MAX_DIV_MARKS,TT.AGRI_GRACE,TT.THEORY_AGRI, TT.PRACTICAL_AGRI,

TRM.GRACEINSUBJECT AS "GRACE MAX. SUBJECT",
IFNULL(SRD.YEAROFADMISION,"") AS BATCH,
IF(TRM.GRADE_LOGIC =1,0,1) AS GRADING,
(CASE
WHEN TRM.GRADE_LOGIC != 1   AND TRM.TR_TYPE = 101 THEN 0
WHEN TRM.GRADE_LOGIC != 1 THEN 1
WHEN TRM.GRADE_LOGIC = 1 AND EFD.SUPPLY_TYPE ="P" AND TRSEMCODE IN ("YR01","YR02","YR03","SM51","SM52") THEN 2
ELSE 3
END) AS TR_TYPE,
IF((TRM.COURSETYPE ="PG" AND CM.COURSESNAME RLIKE "OLD" AND  TRM.GRADE_LOGIC != 1 ), "OLD","NEW") AS GRADE_SYSTEM,

TPSD.COURSETOTALCREDIT,

CASE
WHEN EFD.SUPPLY_TYPE="R" THEN "REGULAR"
WHEN EFD.SUPPLY_TYPE="P" THEN "NON-COLLEGIATE"
ELSE ""
END AS EXAM_STATUS,
CASE
WHEN EFD.EXAM_TYPE IN("EXAMFORM","PRIVATEFORM" ,"PRIVATE" )THEN "MAIN"
WHEN EFD.EXAM_TYPE="RE-APPEAR" AND TRM.TR_TYPE =101 THEN "ATKT"
ELSE EFD.EXAM_TYPE
END AS "Examtype",SRD.USERNAME,
TRM.PASSPERCENTAGE,TRM.TOTALCREDIT,TRM.MINSUBJECT,TRM.TOTALMARK,TRM.MAXGRACE,TRM.MAXSUBJECT,TRM.MIN_PASS_MARKS,TPSD.COURSETOTALCREDIT,
IF(TRM.TRSEMCODE = CM.LOGINCODE,1,0) AS FINALSEM,SP.PICK_TEXT AS RESULT_STATUS,IFNULL(TPSD.REMARKSLINE,"") AS REMARKSLINE,
TPSD.STUDENTSEX AS GENDER,
(SELECT CAT.PICK_TEXT FROM UNI_SYSTEM_SMKV.STOREPICK AS CAT WHERE CAT.STORE_ID="CAT" AND CAT.PICK_ID=TPSD.CATEGORY) AS CATEGORY,
CONCAT(LPAD(IFNULL(SAD.`STUDENT_DOB_DD`,""),2,"0"),"/",LPAD(IFNULL(SAD.`STUDENT_DOB_MM`,""),2,"0"),"/",LPAD(IFNULL(SAD.`STUDENT_DOB_YYYY`,""),4,"0")) AS DOB,
TPSD.TRCOURSECODE,TPSD.STUDENTCODE,TRM.COURSECODE,TRM.TRSEMCODE,TRM.SESSCODE,TRM.RESULTTYPE,TRM.STUDENTTYPE,TRM.`MAINHEADER`,TRM.`SUBHEADER2`,TRM.`SUBHEADER`,
UPPER(TPSD.STUDENTNAME) AS STUDENTNAME,UPPER(TPSD.FATHERSNAME) AS FATHERSNAME,UPPER(TPSD.MOTHERSNAME) AS MOTHERSNAME,
TPSD.EXAMROLLNUMBER AS EXAMROLLNUMBER,TPSD.REGISTRATIONID,
IFNULL(`SAD`.`PATHERSRES_PS`,"") AS PARMANETROLLNUMBER ,TPSD.RESULT,CM.COURSENAME,
TPSD.INSTCODE,IFNULL(TPSD.OLD_MARKS,"") AS OLD_MARKS,IFNULL(TPSD.OLD_MARKS_FROM,"") AS OLD_MARKS_FROM,SEM.SEMNAME AS SEMESTER,SES.SESSDISPNAME,TPSD.WTOTAL,TPSD.WITHHELD_TYPE,TPSD.TOTAL AS TOTAL,TPSD.GTOTAL AS GTOTAL,
TPSD.`REMARKSLINE_GRACE`,UPPER(SP_M.PICK_TEXT) AS MED,CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) AS SGPA,TPSD.THEOTOTAL,TPSD.PRACTOTAL,
IFNULL(IF(TRM.TRSEMCODE = CM.LOGINCODE,CAST(ABS(TPSD.COURSE_CGPA) AS DECIMAL(10,3)),""),"") AS COURSE_CGPA,TPSD.COURSE_DEVISION,IM.INSTSNAME AS COLLEGECODE,
IM.INSTNAME AS COLLEGENAME,IFNULL(`SAD`.`STUDENTACCOUNTNO`,"") AS ABC_ID,


(REPLACE(IFNULL(TPG.ROW1_TOTALGRACE,""),"*","")+REPLACE(IFNULL(TPG.ROW2_TOTALGRACE,""),"*","")+
REPLACE(IFNULL(TPG.ROW3_TOTALGRACE,""),"*","")+REPLACE(IFNULL(TPG.ROW4_TOTALGRACE,""),"*","")+
REPLACE(IFNULL(TPG.ROW5_TOTALGRACE,""),"*","")+REPLACE(IFNULL(TPG.ROW6_TOTALGRACE,""),"*","")+
REPLACE(IFNULL(TPG.ROW7_TOTALGRACE,""),"*","")+REPLACE(IFNULL(TPG.ROW8_TOTALGRACE,""),"*","")+
REPLACE(IFNULL(TPG.ROW9_TOTALGRACE,""),"*","")+REPLACE(IFNULL(TPG.ROW10_TOTALGRACE,""),"*","")+
REPLACE(IFNULL(TPG.ROW11_TOTALGRACE,""),"*","")+REPLACE(IFNULL(TPG.ROW12_TOTALGRACE,""),"*","")+
REPLACE(IFNULL(TPG.ROW13_TOTALGRACE,""),"*","")+REPLACE(IFNULL(TPG.ROW14_TOTALGRACE,""),"*","")+
REPLACE(IFNULL(TPG.ROW15_TOTALGRACE,""),"*","")+REPLACE(IFNULL(TPG.ROW16_TOTALGRACE,""),"*","")
) AS GRACENEED,
TRM.PUBLICATIONDATE,MCNO.MCNUMBER,TRM.SYLLCODE,

CAST(POT.SGPA_SEM1 AS DECIMAL(8,3)) AS SGPA_SM1,
CAST(POT.SGPA_SEM2 AS DECIMAL(8,3)) AS SGPA_SM2,
CAST(POT.SGPA_SEM3 AS DECIMAL(8,3)) AS SGPA_SM3,
CAST(POT.SGPA_SEM4 AS DECIMAL(8,3)) AS SGPA_SM4,
CAST(POT.SGPA_SEM5 AS DECIMAL(8,3)) AS SGPA_SM5,
CAST(POT.SGPA_SEM6 AS DECIMAL(8,3)) AS SGPA_SM6,
CAST(POT.SGPA_SEM7 AS DECIMAL(8,3)) AS SGPA_SM7,
CAST(POT.SGPA_SEM8 AS DECIMAL(8,3)) AS SGPA_SM8,


IFNULL(POT.OBT_SEM1,"") AS OBT1,
IFNULL(POT.OBT_SEM2,"") AS OBT2,
IFNULL(POT.OBT_SEM3,"") AS OBT3,
IFNULL(POT.OBT_SEM4,"") AS OBT4,
IFNULL(POT.OBT_SEM5,"") AS OBT5,
IFNULL(POT.OBT_SEM6,"") AS OBT6,
IFNULL(POT.OBT_SEM7,"") AS OBT7,
IFNULL(POT.OBT_SEM8,"") AS OBT8,


IFNULL(POT.TOT_SEM1,"") AS TOT1,
IFNULL(POT.TOT_SEM2,"") AS TOT2,
IFNULL(POT.TOT_SEM3,"") AS TOT3,
IFNULL(POT.TOT_SEM4,"") AS TOT4,
IFNULL(POT.TOT_SEM5,"") AS TOT5,
IFNULL(POT.TOT_SEM6,"") AS TOT6,
IFNULL(POT.TOT_SEM7,"") AS TOT7,
IFNULL(POT.TOT_SEM8,"") AS TOT8,

CASE
WHEN TRM.TRSEMCODE ="SM01" THEN ""
ELSE
CONCAT(
IF(SEM.NUMERIC>1,CONCAT("S1: ",LPAD(IFNULL(CAST(POT.OBT_SEM1 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM1 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM1,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>2,CONCAT("S2: ",LPAD(IFNULL(CAST(POT.OBT_SEM2 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM2 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM2,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>3,CONCAT("S3: ",LPAD(IFNULL(CAST(POT.OBT_SEM3 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM3 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM3,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>4,CONCAT("S4: ",LPAD(IFNULL(CAST(POT.OBT_SEM4 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM4 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM4,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>5,CONCAT("S5: ",LPAD(IFNULL(CAST(POT.OBT_SEM5 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM5 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM5,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>6,CONCAT("S6: ",LPAD(IFNULL(CAST(POT.OBT_SEM6 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM6 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM6,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>7,CONCAT("S7: ",LPAD(IFNULL(CAST(POT.OBT_SEM7 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM7 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM7,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>8,CONCAT("S8: ",LPAD(IFNULL(CAST(POT.OBT_SEM8 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM8 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM8,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>9,CONCAT("S9: ",LPAD(IFNULL(CAST(POT.OBT_SEM9 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM9 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM9,0) AS DECIMAL(8,3)),"\n"),"")
)
END AS PREVIOUS_DATA,


CASE
WHEN TRM.TRSEMCODE IN ("SM01","SM51","AN01","PR01","YR01") AND TPSD.RESULT="P" THEN IFNULL(TPSD.TOTAL,"")
WHEN TRM.TRSEMCODE IN ("SM02","SM52","PR02","YR02") AND TPSD.RESULT="P" THEN IFNULL(POT.OBT_SEM1,"")+IFNULL(TPSD.TOTAL,"")
WHEN TRM.TRSEMCODE IN ("SM03","PR03","YR03") AND TPSD.RESULT="P" THEN IFNULL(POT.OBT_SEM1,"")+IFNULL(POT.OBT_SEM2,"")+IFNULL(TPSD.TOTAL,"")
WHEN TRM.TRSEMCODE IN ("SM04","PR04","YR04") AND TPSD.RESULT="P" THEN IFNULL(POT.OBT_SEM1,"")+IFNULL(POT.OBT_SEM2,"")+IFNULL(POT.OBT_SEM3,"")+IFNULL(TPSD.TOTAL,"")
WHEN TRM.TRSEMCODE ="SM05" AND TPSD.RESULT="P" THEN IFNULL(POT.OBT_SEM1,"")+IFNULL(POT.OBT_SEM2,"")+IFNULL(POT.OBT_SEM3,"")+IFNULL(POT.OBT_SEM4,"")+IFNULL(TPSD.TOTAL,"")
WHEN TRM.TRSEMCODE ="SM06" AND TPSD.RESULT="P" THEN IFNULL(POT.OBT_SEM1,"")+IFNULL(POT.OBT_SEM2,"")+IFNULL(POT.OBT_SEM3,"")+IFNULL(POT.OBT_SEM4,"")+IFNULL(POT.OBT_SEM5,"")+IFNULL(TPSD.TOTAL,"")
WHEN TRM.TRSEMCODE ="SM07" AND TPSD.RESULT="P" THEN IFNULL(POT.OBT_SEM1,"")+IFNULL(POT.OBT_SEM2,"")+IFNULL(POT.OBT_SEM3,"")+IFNULL(POT.OBT_SEM4,"")+IFNULL(POT.OBT_SEM5,"")+IFNULL(POT.OBT_SEM6,"")+IFNULL(TPSD.TOTAL,"")
WHEN TRM.TRSEMCODE ="SM08" AND TPSD.RESULT="P" THEN IFNULL(POT.OBT_SEM1,"")+IFNULL(POT.OBT_SEM2,"")+IFNULL(POT.OBT_SEM3,"")+IFNULL(POT.OBT_SEM4,"")+IFNULL(POT.OBT_SEM5,"")+IFNULL(POT.OBT_SEM6,"")+IFNULL(POT.OBT_SEM7,"")+IFNULL(TPSD.TOTAL,"")
WHEN TRM.TRSEMCODE ="SM09" AND TPSD.RESULT="P" THEN IFNULL(POT.OBT_SEM1,"")+IFNULL(POT.OBT_SEM2,"")+IFNULL(POT.OBT_SEM3,"")+IFNULL(POT.OBT_SEM4,"")+IFNULL(POT.OBT_SEM5,"")+IFNULL(POT.OBT_SEM6,"")+IFNULL(POT.OBT_SEM7,"")+IFNULL(POT.OBT_SEM8,"")+IFNULL(TPSD.TOTAL,"")
WHEN TRM.TRSEMCODE ="SM10" AND TPSD.RESULT="P" THEN IFNULL(POT.OBT_SEM1,"")+IFNULL(POT.OBT_SEM2,"")+IFNULL(POT.OBT_SEM3,"")+IFNULL(POT.OBT_SEM4,"")+IFNULL(POT.OBT_SEM5,"")+IFNULL(POT.OBT_SEM6,"")+IFNULL(POT.OBT_SEM7,"")+IFNULL(POT.OBT_SEM8,"")+IFNULL(POT.OBT_SEM9,"")+IFNULL(TPSD.TOTAL,"")
ELSE ""
END AS OVERALL_OBT,
CASE
WHEN TRM.TRSEMCODE IN ("SM01","SM51","AN01","PR01","YR01") AND TPSD.RESULT="P" THEN IFNULL(TPSD.GTOTAL,"")
WHEN TRM.TRSEMCODE IN ("SM02","SM52","PR02","YR02") AND TPSD.RESULT="P" THEN IFNULL(POT.TOT_SEM1,"")+IFNULL(TPSD.GTOTAL,"")
WHEN TRM.TRSEMCODE IN ("SM03","PR03","YR03") AND TPSD.RESULT="P" THEN IFNULL(POT.TOT_SEM1,"")+IFNULL(POT.TOT_SEM2,"")+IFNULL(TPSD.GTOTAL,"")
WHEN TRM.TRSEMCODE IN ("SM04","PR04","YR04") AND TPSD.RESULT="P" THEN IFNULL(POT.TOT_SEM1,"")+IFNULL(POT.TOT_SEM2,"")+IFNULL(POT.TOT_SEM3,"")+IFNULL(TPSD.GTOTAL,"")
WHEN TRM.TRSEMCODE ="SM05" AND TPSD.RESULT="P" THEN IFNULL(POT.TOT_SEM1,"")+IFNULL(POT.TOT_SEM2,"")+IFNULL(POT.TOT_SEM3,"")+IFNULL(POT.TOT_SEM4,"")+IFNULL(TPSD.GTOTAL,"")
WHEN TRM.TRSEMCODE ="SM06" AND TPSD.RESULT="P" THEN IFNULL(POT.TOT_SEM1,"")+IFNULL(POT.TOT_SEM2,"")+IFNULL(POT.TOT_SEM3,"")+IFNULL(POT.TOT_SEM4,"")+IFNULL(POT.TOT_SEM5,"")+IFNULL(TPSD.GTOTAL,"")
WHEN TRM.TRSEMCODE ="SM07" AND TPSD.RESULT="P" THEN IFNULL(POT.TOT_SEM1,"")+IFNULL(POT.TOT_SEM2,"")+IFNULL(POT.TOT_SEM3,"")+IFNULL(POT.TOT_SEM4,"")+IFNULL(POT.TOT_SEM5,"")+IFNULL(POT.TOT_SEM6,"")+IFNULL(TPSD.GTOTAL,"")
WHEN TRM.TRSEMCODE ="SM08" AND TPSD.RESULT="P" THEN IFNULL(POT.TOT_SEM1,"")+IFNULL(POT.TOT_SEM2,"")+IFNULL(POT.TOT_SEM3,"")+IFNULL(POT.TOT_SEM4,"")+IFNULL(POT.TOT_SEM5,"")+IFNULL(POT.TOT_SEM6,"")+IFNULL(POT.TOT_SEM7,"")+IFNULL(TPSD.GTOTAL,"")
WHEN TRM.TRSEMCODE ="SM09" AND TPSD.RESULT="P" THEN IFNULL(POT.TOT_SEM1,"")+IFNULL(POT.TOT_SEM2,"")+IFNULL(POT.TOT_SEM3,"")+IFNULL(POT.TOT_SEM4,"")+IFNULL(POT.TOT_SEM5,"")+IFNULL(POT.TOT_SEM6,"")+IFNULL(POT.TOT_SEM7,"")+IFNULL(POT.TOT_SEM8,"")+IFNULL(TPSD.GTOTAL,"")
WHEN TRM.TRSEMCODE ="SM10" AND TPSD.RESULT="P" THEN IFNULL(POT.TOT_SEM1,"")+IFNULL(POT.TOT_SEM2,"")+IFNULL(POT.TOT_SEM3,"")+IFNULL(POT.TOT_SEM4,"")+IFNULL(POT.TOT_SEM5,"")+IFNULL(POT.TOT_SEM6,"")+IFNULL(POT.TOT_SEM7,"")+IFNULL(POT.TOT_SEM8,"")+IFNULL(POT.TOT_SEM9,"")+IFNULL(TPSD.GTOTAL,"")
ELSE ""
END AS OVERALL_TOT,

"" OBT_THEORY_ALL,"" TOT_THEORY_ALL,"" OBT_PRAC_ALL,"" TOT_PRAC_ALL,
(SELECT IF(FINALSEM!=1,"",CAST((OVERALL_OBT/OVERALL_TOT)*100 AS DECIMAL(8,2)))) AS PER,
"" AS TH_PER,
"" AS PR_PER,

(SELECT PICK_TEXT FROM `UNI_SYSTEM_SMKV`.`STOREPICK`  AS SDIV WHERE SDIV.PICK_ID = TPSD.COURSE_DEVISION AND SDIV.STORE_ID="RESULT_DIVISION" AND SDIV.`deleted_at` IS NULL) AS DIVISION,
#(SELECT PICK_TEXT FROM `UNI_SYSTEM_SMKV`.`STOREPICK`  AS SP WHERE SP.PICK_ID = TPSD.RESULT AND  SP.STORE_ID="display_result_syntax" AND  SP.`deleted_at` IS NULL) AS RESULT_STATUS,
(SELECT PICK_TEXT FROM `UNI_SYSTEM_SMKV`.`STOREPICK` AS SPT WHERE SPT.PICK_ID = TPSD.TSTATUS AND SPT.STORE_ID="display_result_syntax" AND SPT.`deleted_at` IS NULL) AS T_RESULT,
(SELECT PICK_TEXT FROM `UNI_SYSTEM_SMKV`.`STOREPICK`  AS SPP WHERE SPP.PICK_ID = TPSD.PSTATUS AND  SPP.STORE_ID="display_result_syntax" AND SPP.`deleted_at` IS NULL) AS P_RESULT,
(SELECT PICK_TEXT FROM `UNI_SYSTEM_SMKV`.`STOREPICK`  AS RTP WHERE RTP.PICK_ID = TRM.RESULTTYPE AND  RTP.STORE_ID="RESULT_TYPE" AND RTP.`deleted_at` IS NULL LIMIT 1) AS `RESULT_TYPE`,
#(SELECT COUNT(*) AS failCount  FROM SUBJECTBILANG_SMKV.TRPRINTSTUDENT_ROWS  AS TR_RR WHERE TR_RR.STUDENTCODE=TPSD.STUDENTCODE
#AND TR_RR.TRCOURSECODE=TPSD.TRCOURSECODE AND TR_RR.SRESULT <> "P" ) AS AGRR,
#(SELECT COUNT(DISTINCT SUBJECTCODE) AS failCount  FROM SUBJECTBILANG_SMKV.TRPRINTSTUDENT_ROWS  AS TR_RR WHERE TR_RR.STUDENTCODE=TPSD.STUDENTCODE
#AND TR_RR.TRCOURSECODE=TPSD.TRCOURSECODE AND LEFT(TR_RR.UNIT,1) NOT IN ("P") AND TR_RR.SRESULT <> "P" ) AS TH_FAIL,

(SELECT IF(COUNT(*)>0,1,0) AS passCount  FROM SUBJECTBILANG_SMKV.TRPRINTSTUDENT_ROWS  AS TR_RR WHERE TR_RR.STUDENTCODE=TPSD.STUDENTCODE
AND TR_RR.TRCOURSECODE=TPSD.TRCOURSECODE AND TR_RR.CTOTAL = "UFM" ) AS UFM_COUNT,


(SELECT
IF(IFNULL(TR_RR.ROW1_RESULT,"")= "P",1,0)+IF(IFNULL(TR_RR.ROW2_RESULT,"")= "P",1,0)+
IF(IFNULL(TR_RR.ROW3_RESULT,"")= "P",1,0)+IF(IFNULL(TR_RR.ROW4_RESULT,"")= "P",1,0)+
IF(IFNULL(TR_RR.ROW5_RESULT,"")= "P",1,0)+IF(IFNULL(TR_RR.ROW6_RESULT,"")= "P",1,0)+
IF(IFNULL(TR_RR.ROW7_RESULT,"")= "P",1,0)+IF(IFNULL(TR_RR.ROW8_RESULT,"")= "P",1,0)+
IF(IFNULL(TR_RR.ROW9_RESULT,"")= "P",1,0)+IF(IFNULL(TR_RR.ROW10_RESULT,"")= "P",1,0)+
IF(IFNULL(TR_RR.ROW11_RESULT,"")= "P",1,0)+IF(IFNULL(TR_RR.ROW12_RESULT,"")= "P",1,0)+
IF(IFNULL(TR_RR.ROW13_RESULT,"")= "P",1,0)+IF(IFNULL(TR_RR.ROW14_RESULT,"")= "P",1,0) AS passCount  
FROM SUBJECTBILANG_SMKV.`TRPRINTSTUDENTDETAILS_TOTAL_EXTRA`  AS TR_RR WHERE TR_RR.STUDENTCODE=TPSD.STUDENTCODE
AND TR_RR.TRCOURSECODE=TPSD.TRCOURSECODE ) AS PASS_COUNT,
(SELECT
IF(IFNULL(TR_RR.ROW1_RESULT,"")= "F",1,0)+IF(IFNULL(TR_RR.ROW2_RESULT,"")= "F",1,0)+
IF(IFNULL(TR_RR.ROW3_RESULT,"")= "F",1,0)+IF(IFNULL(TR_RR.ROW4_RESULT,"")= "F",1,0)+
IF(IFNULL(TR_RR.ROW5_RESULT,"")= "F",1,0)+IF(IFNULL(TR_RR.ROW6_RESULT,"")= "F",1,0)+
IF(IFNULL(TR_RR.ROW7_RESULT,"")= "F",1,0)+IF(IFNULL(TR_RR.ROW8_RESULT,"")= "F",1,0)+
IF(IFNULL(TR_RR.ROW9_RESULT,"")= "F",1,0)+IF(IFNULL(TR_RR.ROW10_RESULT,"")= "F",1,0)+
IF(IFNULL(TR_RR.ROW11_RESULT,"")= "F",1,0)+IF(IFNULL(TR_RR.ROW12_RESULT,"")= "F",1,0)+
IF(IFNULL(TR_RR.ROW13_RESULT,"")= "F",1,0)+IF(IFNULL(TR_RR.ROW14_RESULT,"")= "F",1,0) AS FailCount  
FROM SUBJECTBILANG_SMKV.`TRPRINTSTUDENTDETAILS_TOTAL_EXTRA`  AS TR_RR WHERE TR_RR.STUDENTCODE=TPSD.STUDENTCODE
AND TR_RR.TRCOURSECODE=TPSD.TRCOURSECODE ) AS FAIL_COUNT,
(SELECT CASE
WHEN UFM_COUNT > 0 THEN "UFM"
WHEN TPSD.RESULT ="F" AND IFNULL(TPSD.REMARKSLINE,"") = "ATKT - Short of Aggregate" THEN "ATKT SHORT OF AGGREGATE"
WHEN TPSD.RESULT ="F" AND IFNULL(TPSD.REMARKSLINE,"") = "Promoted" THEN "PROMOTED"
WHEN TPSD.RESULT ="F" AND IFNULL(TPSD.REMARKSLINE,"") = "ATKT" THEN "ATKT"
WHEN TPSD.RESULT ="F" AND IFNULL(TPSD.REMARKSLINE,"") = "FAIL" THEN "FAIL"
WHEN TPSD.RESULT ="F" AND IFNULL(TPSD.REMARKSLINE,"") = "Detained" THEN "DETAINED"
WHEN TPSD.RESULT ="F" AND IFNULL(TPSD.REMARKSLINE,"") = "Absent" THEN "ABSENT"
WHEN IFNULL(TPSD.REMARKSLINE,"") ="W" THEN "WITH HELD"
ELSE SP.PICK_TEXT
END ) AS FINAL_RES




FROM `TRPRINTSTUDENTDETAILS` AS TPSD ;]]>
</queryString>

<field name="EXAM_CODE" class="java.lang.String">
    <property name="com.jaspersoft.studio.field.label" value="EXAM_CODE"/>
</field>
<field name="MAX MARKS" class="java.lang.String">
    <property name="com.jaspersoft.studio.field.label" value="MAX MARKS"/>
</field>
<field name="COURSETOTALCREDIT" class="java.lang.String">
    <property name="com.jaspersoft.studio.field.label" value="COURSETOTALCREDIT"/>
</field>
<field name="TRCREDIT" class="java.lang.String">
    <property name="com.jaspersoft.studio.field.label" value="TRCREDIT"/>
</field>
<field name="MIN MARKS" class="java.lang.String">
    <property name="com.jaspersoft.studio.field.label" value="MIN MARKS"/>
</field>
