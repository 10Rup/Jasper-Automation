<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1a3ec0e9-a736-460b-81a4-fa0e06798b78">
<queryString>
		<![CDATA[SELECT 
    efd.rollno AS RollNo,
    efd.studentcode AS StudentCode,
    sad.STUDENTFNAME AS StudentFirstName,
    sad.STUDENTMNAME AS StudentMiddleName,
    sad.STUDENTLNAME AS StudentLastName,
    sad.FATHERSNAME AS FatherName,
    sad.MOTHERSNAME AS MotherName,
    sad.STUDENTSEX AS Gender,
    CONCAT(sad.STUDENT_DOB_DD, '-', sad.STUDENT_DOB_MM, '-', sad.STUDENT_DOB_YYYY) AS DateOfBirth,
    sad.STUDENTCATEGORY AS Category,
    sad.STUDENT_ADDHARCARD AS AadharNumber,
    sad.STUDENT_COMMUNICATION_ADDLINE1 AS Address,
    sad.STUDENT_COMMUNICATION_CITY AS City,
    sad.STUDENT_COMMUNICATION_DISTRICT AS District,
    sad.STUDENT_COMMUNICATION_STATE AS State,
    sad.STUDENT_COMMUNICATION_PINCODE AS Pincode,
    srd.STCOMMEMAIL AS Email,
    srd.STCOMMMOBILE AS Mobile,
    efd.fcd AS CourseCode,
    sem.SEMNAME AS SemesterName,
    sess.SESSNAME AS SessionName,
    efd.studenttype AS StudentType,
    efd.form_status AS FormStatus,
    efd.center_id AS CenterID,
    efd.created_at AS RegistrationDate,
    sps.STUDENTPHOTOPATH AS PhotoPath,
    sps.STUDENTSIGNATUREPATH AS SignaturePath
FROM UNI_SYS_MZU.exam_form_details efd
JOIN UNI_SYS_MZU.STUDENTAPPLICANTDATA sad 
    ON efd.studentcode = sad.STUDENTCODE
JOIN UNI_SYS_MZU.STUDENTROLLDATA srd 
    ON efd.studentcode = srd.STUDENTCODE
LEFT JOIN UNI_SYS_MZU.STUDENTPHOTOSIGN sps 
    ON efd.studentcode = sps.STUDENTCODE
JOIN UNI_SYS_MZU.SEMESTERMST sem 
    ON efd.semcode = sem.SEMCODE
JOIN UNI_SYS_MZU.SESSIONMST sess 
    ON efd.sesscode = sess.SESSCODE
WHERE efd.fcd = :course
    AND efd.semcode = :semester
    AND efd.sesscode = :session
    AND efd.form_status = '55'
    AND efd.deleted_at IS NULL
ORDER BY efd.rollno]]>
	</queryString>
