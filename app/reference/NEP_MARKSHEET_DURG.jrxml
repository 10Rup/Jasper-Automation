	<variable name="result_data" class="java.lang.String">
		<variableExpression><![CDATA[($F{WITHHELD_TYPE}.equals("W/U") && $F{RESULT}.equals("W"))?"UFM":($F{AGRR}==0 && ($F{RESULT}.equals("S") || $F{RESULT}.equals("F")))
?(($F{EXAM_TYPE}.equals("RE-APPEAR") && $F{chance}>1)?"FAIL":"FAIL IN AGGREGATE"):
$F{REMARKSLINE_GRACE}.equals("VC") && (Math.round($F{GRACENEED})>0) && $F{RESULT}.equals("P") ?"PASS BY VC GRACE": 
$F{RESULT_STATUS}.equals("SUPPLY")?"ATKT"+((Math.round($F{GRACENEED})>0)?("  GRACE, "+Math.round($F{GRACENEED})):""): 
$F{RESULT_STATUS}.equals("W/T")?"WITH HELD"+((Math.round($F{GRACENEED})>0)?("  GRACE, "+Math.round($F{GRACENEED})):""):
($F{RESULT_STATUS}.toUpperCase()+($F{RESULT_STATUS}.equals("PASS")?((Math.round($F{GRACENEED})>0)?("  GRACE, "+Math.round($F{GRACENEED})):""):""))]]></variableExpression>
	</variable>
