		<property name="com.jaspersoft.studio.field.label" value="MIN_PASS_MARKS"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TRROOTMASTER"/>
	</field>
	<field name="COURSETOTALCREDIT" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="COURSETOTALCREDIT"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TRPRINTSTUDENTDETAILS"/>
	</field>
	<field name="FINALSEM" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="FINALSEM"/>
	</field>
	<field name="RESULT_STATUS" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="RESULT_STATUS"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="STOREPICK"/>
	</field>
	<field name="REMARKSLINE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="REMARKSLINE"/>
