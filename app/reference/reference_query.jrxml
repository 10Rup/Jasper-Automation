<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CBLU MARKSHEET" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="140" bottomMargin="40" isFloatColumnFooter="true" uuid="84cb6786-deac-488a-88ff-18c11e27c6f8">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="IGU_NEP CBLU_MCU"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w1" value="687"/>
	<property name="com.jaspersoft.studio.property.dataset.dialog.DatasetDialog.sash.w2" value="302"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="315"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="680"/>
	<property name="com.jaspersoft.studio.unit." value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageHeight" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.pageWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.topMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.leftMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.rightMargin" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnWidth" value="pixel"/>
	<property name="com.jaspersoft.studio.unit.columnSpacing" value="pixel"/>
	<parameter name="SESSCODE" class="java.lang.String"/>
	<parameter name="sem_code" class="java.lang.String"/>
	<parameter name="course_name" class="java.lang.String"/>
	<parameter name="STUDENTTYPE" class="java.lang.String"/>
	<parameter name="RESULTTYPE" class="java.lang.String"/>
	<parameter name="SYLLCODE" class="java.lang.String"/>
	<parameter name="ROLLNO" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT 
ABS(IFNULL(THPR.TOTAL_THEO_MARKS,"0")) AS TOTAL_THEO_MARKS,
ABS(IFNULL(THPR.TOTAL_THEO_OBT_MARKS,"0")) AS TOTAL_THEO_OBT_MARKS,
ABS(IFNULL(THPR.TOTAL_PRAC_MARKS,"0")) AS TOTAL_PRAC_MARKS,
ABS(IFNULL(THPR.TOTAL_PRAC_OBT_MARKS,"0")) AS TOTAL_PRAC_OBT_MARKS,
ABS(IFNULL(THPR.TOTAL_MAX_MARKS,"0")) AS TOTAL_MAX_MARKS,
ABS(IFNULL(THPR.TOTAL_OBT_MARKS,"0")) AS TOTAL_OBT_MARKS,
IFNULL(THPR.RESULT,"") AS RESULT_1,
IFNULL(SRD.YEAROFADMISION,"") AS BATCH,TRM.COURSETYPE,
CASE 
WHEN EFD.EXAM_TYPE="EXAMFORM" THEN "MAIN"
WHEN EFD.EXAM_TYPE="RE-APPEAR" THEN "RE-APPEAR"
ELSE UPPER(EFD.EXAM_TYPE)
END AS EXAM_STATUS,
TRM.PASSPERCENTAGE,TRM.TOTALCREDIT,TRM.MINSUBJECT,TRM.TOTALMARK,TRM.MAXGRACE,TRM.MIN_PASS_MARKS,TPSD.COURSETOTALCREDIT,
IF(TRM.TRSEMCODE = CM.LOGINCODE,1,0) AS FINALSEM,SP_R.PICK_TEXT AS RESULT_STATUS,IFNULL(TPSD.REMARKSLINE,"") AS REMARKSLINE,
TPSD.STUDENTSEX AS GENDER,
(SELECT CAT.PICK_TEXT FROM UNI_SYSTEM_CBLU.STOREPICK AS CAT WHERE CAT.STORE_ID="CAT" AND CAT.PICK_ID=TPSD.CATEGORY) AS CATEGORY,
CONCAT(LPAD(IFNULL(SAD.`STUDENT_DOB_DD`,""),2,"0"),"/",LPAD(IFNULL(SAD.`STUDENT_DOB_MM`,""),2,"0"),"/",LPAD(IFNULL(SAD.`STUDENT_DOB_YYYY`,""),4,"0")) AS DOB,
TPSD.TRCOURSECODE,TPSD.STUDENTCODE,TRM.COURSECODE,TRM.TRSEMCODE,TRM.SESSCODE,TRM.RESULTTYPE,TRM.STUDENTTYPE,TRM.`MAINHEADER`,TRM.`SUBHEADER2`,TRM.`SUBHEADER`,
UPPER(TPSD.STUDENTNAME) AS STUDENTNAME,UPPER(TPSD.FATHERSNAME) AS FATHERSNAME,UPPER(TPSD.MOTHERSNAME) AS MOTHERSNAME,SAD.PATHERSRES_PS AS EXAMROLLNUMBER,TPSD.REGISTRATIONID,
IF((`TRM`.`COURSETYPE` = "PG" OR TRM.COURSECODE IN ("C000004","C000064","C000073","C000063","C000012")),`SAD`.`GURDIANSRES_PS`,SAD.PATHERSRES_PS) AS PARMANETROLLNUMBER ,TPSD.RESULT,CM.COURSENAME,
TPSD.INSTCODE,IFNULL(TPSD.OLD_MARKS,"") AS OLD_MARKS,IFNULL(TPSD.OLD_MARKS_FROM,"") AS OLD_MARKS_FROM,SEM.SEMNAME AS SEMESTER,SES.SESSDISPNAME,TPSD.WTOTAL,TPSD.WITHHELD_TYPE,TPSD.TOTAL AS TOTAL,TPSD.GTOTAL AS GTOTAL,
TPSD.`REMARKSLINE_GRACE`,UPPER(SP_M.PICK_TEXT) AS MED,CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) AS SGPA,TPSD.THEOTOTAL,TPSD.PRACTOTAL,
IFNULL(IF(TRM.TRSEMCODE = CM.LOGINCODE AND TPSD.RESULT="P",CAST(ABS(POT.CGPA) AS DECIMAL(10,2)),""),"") AS COURSE_CGPA,

IF(TRM.TRSEMCODE = CM.LOGINCODE,
CASE 
WHEN CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) = 0 THEN "F"
WHEN CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) > 0 AND CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) <=4 THEN "C+"
WHEN CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) > 4 AND CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) <=5 THEN "B-"
WHEN CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) > 5 AND CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) <=6 THEN "B"
WHEN CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) > 6 AND CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) <=7 THEN "B+"
WHEN CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) > 7 AND CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) <=8 THEN "A-"
WHEN CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) > 8 AND CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) <=9 THEN "A"
WHEN CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) > 9 AND CAST(ABS(POT.CGPA) AS DECIMAL(10,2)) <=10 THEN "A+"
ELSE ""
END,
CASE 
WHEN CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) = 0 THEN "F"
WHEN CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) > 0 AND CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) <=4 THEN "C+"
WHEN CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) > 4 AND CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) <=5 THEN "B-"
WHEN CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) > 5 AND CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) <=6 THEN "B"
WHEN CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) > 6 AND CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) <=7 THEN "B+"
WHEN CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) > 7 AND CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) <=8 THEN "A-"
WHEN CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) > 8 AND CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) <=9 THEN "A"
WHEN CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) > 9 AND CAST(TPSD.COURSE_SGPA AS DECIMAL(10,2)) <=10 THEN "A+"
ELSE ""
END) AS LETTER_GRADE,
TPSD.COURSE_DEVISION,IM.INSTSNAME AS COLLEGECODE,
IM.INSTNAME AS COLLEGENAME,IFNULL(`SAD`.`STUDENTACCOUNTNO`,"") AS ABC_ID,TPSD.GRACENEED,
DATE_FORMAT(STR_TO_DATE(TRM.PUBLICATIONDATE,"%m/%d/%Y"),"%d/%m/%Y") AS PUBLICATIONDATE,TPSD.MCNUMBER,



IFNULL(POT.OBT_SEM1,"") AS OBT1,
IFNULL(POT.OBT_SEM2,"") AS OBT2,
IFNULL(POT.OBT_SEM3,"") AS OBT3,
IFNULL(POT.OBT_SEM4,"") AS OBT4,
IFNULL(POT.OBT_SEM5,"") AS OBT5,
IFNULL(POT.OBT_SEM6,"") AS OBT6,
IFNULL(POT.OBT_SEM7,"") AS OBT7,
IFNULL(POT.OBT_SEM8,"") AS OBT8,
IFNULL(POT.OBT_SEM9,"") AS OBT9,
IFNULL(POT.OBT_SEM10,"") AS OBT10,


IFNULL(POT.TOT_SEM1,"") AS TOT1,
IFNULL(POT.TOT_SEM2,"") AS TOT2,
IFNULL(POT.TOT_SEM3,"") AS TOT3,
IFNULL(POT.TOT_SEM4,"") AS TOT4,
IFNULL(POT.TOT_SEM5,"") AS TOT5,
IFNULL(POT.TOT_SEM6,"") AS TOT6,
IFNULL(POT.TOT_SEM7,"") AS TOT7,
IFNULL(POT.TOT_SEM8,"") AS TOT8,
IFNULL(POT.TOT_SEM9,"") AS TOT9,
IFNULL(POT.TOT_SEM10,"") AS TOT10,

CASE
WHEN TRM.TRSEMCODE ="SM01" THEN ""
ELSE 
CONCAT(
IF(SEM.NUMERIC>1,CONCAT("S1: ",LPAD(IFNULL(CAST(POT.OBT_SEM1 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM1 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM1,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>2,CONCAT("S2: ",LPAD(IFNULL(CAST(POT.OBT_SEM2 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM2 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM2,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>3,CONCAT("S3: ",LPAD(IFNULL(CAST(POT.OBT_SEM3 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM3 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM3,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>4,CONCAT("S4: ",LPAD(IFNULL(CAST(POT.OBT_SEM4 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM4 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM4,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>5,CONCAT("S5: ",LPAD(IFNULL(CAST(POT.OBT_SEM5 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM5 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM5,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>6,CONCAT("S6: ",LPAD(IFNULL(CAST(POT.OBT_SEM6 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM6 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM6,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>7,CONCAT("S7: ",LPAD(IFNULL(CAST(POT.OBT_SEM7 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM7 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM7,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>8,CONCAT("S8: ",LPAD(IFNULL(CAST(POT.OBT_SEM8 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM8 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM8,0) AS DECIMAL(8,3)),"\n"),""),
IF(SEM.NUMERIC>9,CONCAT("S9: ",LPAD(IFNULL(CAST(POT.OBT_SEM9 AS SIGNED),""),4,"0")," /",LPAD(IFNULL(CAST(POT.TOT_SEM9 AS SIGNED),""),4,"0"),"  ",CAST(IFNULL(POT.SGPA_SEM9,0) AS DECIMAL(8,3)),"\n"),"")
)
END AS PREVIOUS_DATA,


(IFNULL(POT.OBT_SEM1,"")+IFNULL(POT.OBT_SEM2,"")+IFNULL(POT.OBT_SEM3,"")+IFNULL(POT.OBT_SEM4,"")+
IFNULL(POT.OBT_SEM5,"")+IFNULL(POT.OBT_SEM6,"")+IFNULL(POT.OBT_SEM7,"")+IFNULL(POT.OBT_SEM8,"")+
IFNULL(POT.OBT_SEM9,"")+IFNULL(POT.OBT_SEM10,"")) AS OVERALL_OBT,
(IFNULL(POT.TOT_SEM1,"")+IFNULL(POT.TOT_SEM2,"")+IFNULL(POT.TOT_SEM3,"")+IFNULL(POT.TOT_SEM4,"")+
IFNULL(POT.TOT_SEM5,"")+IFNULL(POT.TOT_SEM6,"")+IFNULL(POT.TOT_SEM7,"")+IFNULL(POT.TOT_SEM8,"")+
IFNULL(POT.TOT_SEM9,"")+IFNULL(POT.TOT_SEM10,"")) AS OVERALL_TOT,

"" OBT_THEORY_ALL,"" TOT_THEORY_ALL,"" OBT_PRAC_ALL,"" TOT_PRAC_ALL,
(SELECT IF(FINALSEM!=1,"",CAST((OVERALL_OBT/OVERALL_TOT)*100 AS DECIMAL(8,2)))) AS PER,
"" AS TH_PER,
"" AS PR_PER,

(SELECT PICK_TEXT FROM `UNI_SYSTEM_CBLU`.`STOREPICK`  AS SDIV WHERE SDIV.PICK_ID = TPSD.COURSE_DEVISION AND SDIV.STORE_ID="RESULT_DIVISION" AND SDIV.`deleted_at` IS NULL) AS DIVISION,
(SELECT PICK_TEXT FROM `UNI_SYSTEM_CBLU`.`STOREPICK` AS SPT WHERE SPT.PICK_ID = TPSD.TSTATUS AND SPT.STORE_ID="display_result_syntax" AND SPT.`deleted_at` IS NULL) AS T_RESULT,
(SELECT PICK_TEXT FROM `UNI_SYSTEM_CBLU`.`STOREPICK`  AS SPP WHERE SPP.PICK_ID = TPSD.PSTATUS AND  SPP.STORE_ID="display_result_syntax" AND SPP.`deleted_at` IS NULL) AS P_RESULT,
(SELECT PICK_TEXT FROM `UNI_SYSTEM_CBLU`.`STOREPICK`  AS RTP WHERE RTP.PICK_ID = TRM.RESULTTYPE AND  RTP.STORE_ID="RESULT_TYPE" AND RTP.`deleted_at` IS NULL LIMIT 1) AS `RESULT_TYPE`


FROM `SUBJECTBILANG_CBLU`.`TRPRINTSTUDENTDETAILS` AS TPSD 

INNER  JOIN `UNI_SYSTEM_CBLU`.`STUDENTAPPLICANTDATA` AS SAD
ON TPSD.STUDENTCODE = SAD.STUDENTCODE

INNER JOIN `UNI_SYSTEM_CBLU`.STUDENTROLLDATA AS SRD
ON TPSD.STUDENTCODE = SRD.STUDENTCODE

INNER JOIN `SUBJECTBILANG_CBLU`.`TRROOTMASTER` AS TRM 
ON TPSD.TRCOURSECODE = TRM.TRCOURSECODE 
AND TRM.SESSCODE=  $P{SESSCODE} 
AND TRM.TRSEMCODE =  $P{sem_code} 
AND TRM.STUDENTTYPE=  $P{STUDENTTYPE} 
AND TRM.RESULTTYPE=  $P{RESULTTYPE} 
AND TRM.deleted_at IS NULL

INNER  JOIN `UNI_SYSTEM_CBLU`.`exam_form_details` AS EFD
ON EFD.STUDENTCODE = TPSD.STUDENTCODE
AND TPSD.FACUCOURSEDEGREECODE=EFD.fcd
AND TRM.SESSCODE = EFD.sesscode
AND TRM.TRSEMCODE = EFD.semcode
AND EFD.EXAM_TYPE NOT IN ("ENROLLMENTFORM")
AND EFD.studenttype = TRM.STUDENTTYPE
#AND EFD.form_status ="55"
AND EFD.deleted_at IS NULL

INNER JOIN `UNI_SYSTEM_CBLU`.`SEMESTERMST` AS SEM ON TRM.TRSEMCODE = SEM.SEMCODE

INNER JOIN `UNI_SYSTEM_CBLU`.`COURSEMST` AS CM ON TRM.COURSECODE=CM.COURSECD

INNER JOIN `UNI_SYSTEM_CBLU`.`SESSIONMST` AS SES ON SES.SESSCODE=TRM.SESSCODE

INNER JOIN `UNI_SYSTEM_CBLU`.`INSTMST` AS IM ON TPSD.INSTCODE = IM.INSTCODE

LEFT JOIN  `UNI_SYSTEM_CBLU`.`STOREPICK`  AS SP ON TPSD.RESULT=SP.PICK_ID AND  SP.STORE_ID="display_result_syntax"

LEFT JOIN `UNI_SYSTEM_CBLU`.`STOREPICK`  AS SDIV ON TPSD.COURSE_DEVISION=SDIV.PICK_ID
AND SDIV.STORE_ID="RESULT_DIVISION"

LEFT JOIN `SUBJECTBILANG_CBLU`.`TRPASSOUTDATATABLE` AS POT ON POT.STUDENTCODE = TPSD.STUDENTCODE  
AND POT.FACUCOURSEDEGREECODE = TPSD.FACUCOURSEDEGREECODE

LEFT JOIN `SUBJECTBILANG_CBLU`.BED_PRAC_THEO_MARKS AS THPR
ON THPR.STUDENTCODE = TPSD.STUDENTCODE
AND THPR.FACUCOURSEDEGREECODE = TPSD.FACUCOURSEDEGREECODE

LEFT JOIN `UNI_SYSTEM_CBLU`.`STOREPICK` AS SP_M ON TPSD.MEDIUM=SP_M.PICK_ID AND SP_M.STORE_ID="ESAY"
LEFT  JOIN  `UNI_SYSTEM_CBLU`.`STOREPICK`  AS SP_R ON TPSD.RESULT=SP_R.PICK_ID AND  SP_R.STORE_ID="display_result_syntax"
WHERE TRM.COURSECODE =  $P{course_name} 
AND TRM.SYLLCODE =  $P{SYLLCODE} 
AND IF($P{ROLLNO}="NA",1=1,TPSD.EXAMROLLNUMBER =  $P{ROLLNO})
AND IF(TRM.TRSEMCODE = CM.LOGINCODE,
(CASE
WHEN (TRM.COURSECODE  IN ("C000076","C000011","C000118","C000119","C000012")  AND IFNULL(THPR.RESULT,"")="PASS" AND TPSD.RESULT="P") THEN "P"
WHEN (TRM.COURSECODE="C000007" AND TPSD.RESULT="P") THEN "P"
WHEN (TRM.COURSECODE="C000031" AND TPSD.RESULT="P") THEN "P" 
WHEN (TRM.COURSECODE!="C000012" AND TRM.TRSEMCODE NOT RLIKE "YR" AND POT.CGPA!="N/A") THEN "P"
#WHEN (TRM.COURSECODE IN ("C000076","C000011","C000118","C000119") AND POT.RESULT_SEM1="P" AND POT.RESULT_SEM2="P") THEN "P"
ELSE "F"
END),TPSD.RESULT) = "P"
GROUP BY TPSD.TRCOURSECODE,TPSD.INSTCODE,TPSD.STUDENTCODE 
ORDER BY TPSD.TRCOURSECODE,TPSD.`COLLEGECODE`,EXAMROLLNUMBER;]]>
	</queryString>
	<field name="TOTAL_THEO_MARKS" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="TOTAL_THEO_MARKS"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BED_PRAC_THEO_MARKS"/>
	</field>
	<field name="TOTAL_THEO_OBT_MARKS" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="TOTAL_THEO_OBT_MARKS"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BED_PRAC_THEO_MARKS"/>
	</field>
	<field name="TOTAL_PRAC_MARKS" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="TOTAL_PRAC_MARKS"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BED_PRAC_THEO_MARKS"/>
	</field>
	<field name="TOTAL_PRAC_OBT_MARKS" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="TOTAL_PRAC_OBT_MARKS"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BED_PRAC_THEO_MARKS"/>
	</field>
	<field name="TOTAL_MAX_MARKS" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="TOTAL_MAX_MARKS"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BED_PRAC_THEO_MARKS"/>
	</field>
	<field name="TOTAL_OBT_MARKS" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="TOTAL_OBT_MARKS"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BED_PRAC_THEO_MARKS"/>
	</field>
	<field name="RESULT_1" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="RESULT_1"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="BED_PRAC_THEO_MARKS"/>
	</field>
	<field name="BATCH" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="BATCH"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="STUDENTROLLDATA"/>
	</field>
	<field name="COURSETYPE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="COURSETYPE"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TRROOTMASTER"/>
	</field>
	<field name="EXAM_STATUS" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="EXAM_STATUS"/>
	</field>
	<field name="PASSPERCENTAGE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="PASSPERCENTAGE"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TRROOTMASTER"/>
	</field>
	<field name="TOTALCREDIT" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="TOTALCREDIT"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TRROOTMASTER"/>
	</field>
	<field name="MINSUBJECT" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="MINSUBJECT"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TRROOTMASTER"/>
	</field>
	<field name="TOTALMARK" class="java.lang.Integer">
		<property name="com.jaspersoft.studio.field.label" value="TOTALMARK"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TRROOTMASTER"/>
	</field>
