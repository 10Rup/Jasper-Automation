<!-- Created with Jaspersoft Studio version 6.8.0.final using JasperReports Library version 6.8.0-2ed8dfabb690ff337a5797129f2cd92902b0c87b  -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="MARK_ENTRY_SUMMARY" pageWidth="3500" pageHeight="555" orientation="Landscape" columnWidth="3500" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" isIgnorePagination="true" uuid="69acb0e6-da92-4263-a5bd-3a7aa3f7d43d">
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DPSRU_KSDSU"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w1" value="384"/>
	<property name="com.jaspersoft.studio.data.sql.SQLQueryDesigner.sash.w2" value="611"/>
	<parameter name="SESSCODE" class="java.lang.String"/>
	<parameter name="sem_code" class="java.lang.String"/>
	<parameter name="institute_code" class="java.lang.String"/>
	<parameter name="course_name" class="java.lang.String"/>
	<parameter name="EXAM_TYPE" class="java.lang.String"/>
	<parameter name="PAPER_TYPE" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[WITH STU AS (SELECT  
VS.INSTCODE,EFD.SEMCODE,EFD.SESSCODE,EFD.`exam_type`,VS.`COURSECD`,VS.ROLLNO,EFD.STUDENTCODE,VS.COURSENAME,VS.INSTNAME,VS.INSTSNAME,
SP.SUBJECTCODE,SMP.TYPE,SMP.UNIT,SMP.UNITNAME,SEM.SEMESTER,SES.SESSDISPNAME AS `SESSION`,
#GROUP_CONCAT(IFNULL(IF(IFNULL(MET.OTHER_REMARK,"")="",MET.MARKS,MET.OTHER_REMARK),"MARK ENTRY NOT DONE") ORDER BY MET.id DESC) AS OBT_MARKS,
# MAX(IF(IFNULL(MET.OTHER_REMARK,"")="",MET.MARKS,MET.OTHER_REMARK)) AS DASDA,
# MIN(IF(IFNULL(MET.OTHER_REMARK,"")="",MET.MARKS,MET.OTHER_REMARK)) AS DASDA,
SMP.SUBJDECS,SMP.SUBJECTUCODE,
SUBSTRING_INDEX(GROUP_CONCAT(IFNULL(IF(IFNULL(MET.OTHER_REMARK,"")="",MET.MARKS,MET.OTHER_REMARK),"MARK ENTRY NOT DONE") ORDER BY MET.id DESC),",",1) AS MARK1,
IF(COUNT(MET.STUDENTCODE)=2,SUBSTRING_INDEX(GROUP_CONCAT(IFNULL(IF(IFNULL(MET.OTHER_REMARK,"")="",MET.MARKS,MET.OTHER_REMARK),"MARK ENTRY NOT DONE") ORDER BY MET.id ASC),",",1),"") AS MARK2,
COUNT(MET.STUDENTCODE) AS ENTRY_COUNT,
SUBSTRING_INDEX(GROUP_CONCAT(DISTINCT U.USERNAME ORDER BY ABS(MET.USERCODE) ASC),",",1) AS USER1,
IF(COUNT(MET.STUDENTCODE)>1,SUBSTRING_INDEX(GROUP_CONCAT(DISTINCT U.USERNAME ORDER BY ABS(MET.USERCODE) DESC),",",1),NULL) AS USER2

FROM `UNI_SYS_MZU`.`exam_form_details` AS EFD

INNER JOIN `UNI_SYS_MZU`.`VIEW_STUDENTENROLLED` AS VS
ON VS.`STUDENTCODE` = EFD.STUDENTCODE
AND VS.`COURSECD`=  $P{course_name} 
AND VS.INSTCODE in ( $P!{institute_code} )

INNER JOIN `UNI_SYS_MZU`.`SEMESTERMST` AS SEM
ON SEM.SEMCODE = EFD.SEMCODE

INNER JOIN `UNI_SYS_MZU`.`SESSIONMST` AS SES
ON SES.SESSCODE = EFD.SESSCODE


INNER JOIN `UNI_SYS_MZU`.`STUDENTPAPERMAPPING` AS SP
ON SP.`STUDENTCODE` = EFD.`studentcode`
AND SP.FACUCOURSEDEGREECODE = EFD.`fcd`
AND SP.SEMCODE = EFD.`semcode`
AND SP.SESSCODE = EFD.SESSCODE
AND SP.SEMTYPE = EFD.STUDENTTYPE
AND SP.`deleted_at` IS NULL 

INNER JOIN `SUBJECTBILANG_MZU`.`SUBJECTMSTEVENSEM_PART` AS SMP
ON SMP.COURSECODE = VS.`COURSECD`
AND SMP.SEMCODE = EFD.SEMCODE
AND SMP.SUBJECTCODE = SP.SUBJECTCODE
AND SMP.TYPE  in ( $P!{PAPER_TYPE} )
AND SMP.`deleted_at` IS NULL


LEFT JOIN `UNI_SYS_MZU`.`MARK_ENTRY_TMP1` AS MET
ON MET.`STUDENTCODE` = EFD.`studentcode`
AND MET.`SYLLCODE` = EFD.`syllcode`
AND MET.SESSCODE  = EFD.`sesscode`
AND MET.`SEMCODE` = EFD.SEMCODE
AND MET.`SUBJECTCODE` = SP.`SUBJECTCODE`
AND MET.FACUCOURSEDEGREECODE = EFD.`fcd`
AND MET.TYPE = SMP.TYPE
AND MET.UNIT = SMP.`UNIT`
AND MET.`deleted_at` IS NULL


LEFT JOIN `UNI_SYS_MZU`.`users`  AS U
ON U.ID = MET.USERCODE
AND U.DELETED_AT IS NULL


WHERE  EFD.semcode=  $P{sem_code} 
AND EFD.`exam_type` = $P{EXAM_TYPE} 
AND EFD.`form_status`='55'
AND EFD.`sesscode`=  $P{SESSCODE} 
AND EFD.`deleted_at` IS NULL

#and EFD.STUDENTCODE ='MZ0005839'

GROUP BY EFD.STUDENTCODE,SP.SUBJECTCODE,SMP.TYPE,SMP.UNIT)


SELECT 
DATE_FORMAT(CONVERT_TZ(NOW(),"-05:30","+00:00"),"%d/%m/%Y %r") AS print_date,
INSTCODE,SEMCODE,SESSCODE,COURSECD,SUBJECTCODE,TYPE,UNIT,
COURSENAME,INSTNAME,INSTSNAME,SEMESTER,`SESSION`,
UNITNAME,SUBJDECS,SUBJECTUCODE,
COUNT(STUDENTCODE) AS TOTAL,
SUM(IF(ENTRY_COUNT=2 AND MARK1 != MARK2,1,0)) "MISMATCH ENTRY",
GROUP_CONCAT(IF(ENTRY_COUNT=2 AND MARK1 != MARK2,ROLLNO,NULL) ORDER BY ROLLNO ASC) AS MISMATCH,
SUM(IF(ENTRY_COUNT=2 AND MARK1=MARK2 AND (MARK1!='' AND MARK2!='') ,1,0)) "DOUBLE ENTRY COMPLETE",
SUM(IF(ENTRY_COUNT=1,1,0)) AS  "ONE ENTRY LEFT", 
SUM(IF(ENTRY_COUNT=0,1,0)) AS  "MISSING ENTRY",
GROUP_CONCAT(IF(ENTRY_COUNT=0,ROLLNO,NULL) ORDER BY ROLLNO ASC) AS MISSING,
GROUP_CONCAT(IF(ENTRY_COUNT=0,ROLLNO,NULL) ORDER BY ROLLNO ASC) AS MISSING,
GROUP_CONCAT(DISTINCT USER1) AS USER1,GROUP_CONCAT(DISTINCT USER2) AS USER2


FROM  STU

GROUP BY STU.COURSECD,STU.INSTCODE,STU.SEMCODE,STU.SUBJECTCODE,STU.TYPE,STU.UNIT
ORDER BY STU.INSTCODE,STU.COURSECD,STU.SEMCODE,STU.SUBJECTCODE,STU.TYPE,STU.UNIT]]>
	</queryString>
