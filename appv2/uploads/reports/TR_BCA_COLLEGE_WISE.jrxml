TPSD.LANGTAG,
TPSD.THEOTOTAL,
TPSD.TOTAL,
ROUND(((TPSD.TOTAL/TPSD.GTOTAL)*100),2) AS PERCNT,
TPSD.PRACTOTAL,
TPSD.THEOOBT,
TPSD.PRACOBT,
TPSD.WTOTAL,
TRM.TRCOURSENAME          AS course,
TRM.DISPLAYINTR,
CSC.MAINHEADER,
CSC.SUBHEADER,
