(SELECT
GROUP_CONCAT(DISTINCT(CONCAT(SBM.SUBQCODE," ",SBM.SUBJDECS)) ORDER BY SUBQCODE ASC SEPARATOR ' ')
FROM `SUBJECTBILANG_SGBAU`.`COURSE_TYPE_SUBJECT_SCHEMA` AS SC
INNER JOIN `SUBJECTBILANG_SGBAU`.`SUBJECTMSTEVENSEM_PART` AS SBM
ON SC.SUBJECTCODE = SBM.SUBJECTCODE
WHERE SC.COURSECODE = TRM.COURSECODE
AND SC.SEMECODE = TRM.TRSEMCODE) AS SUBJECT,
(SELECT
ORESULT
FROM SUBJECTBILANG_SGBAU.TRPRINTSTUDENT_ORESULT
WHERE SUBJECTCODE = TPSD_TE.ROW1_SUBJECTCODE
AND STUDENTCODE = TPSD_TE.STUDENTCODE
AND TRCOURSECODE = TPSD_TE.TRCOURSECODE
LIMIT 1) AS RPE1,
(SELECT
ORESULT
FROM SUBJECTBILANG_SGBAU.TRPRINTSTUDENT_ORESULT
WHERE SUBJECTCODE = TPSD_TE.ROW2_SUBJECTCODE
AND STUDENTCODE = TPSD_TE.STUDENTCODE
