TR_SUM.BOYS_APPEARED,
TR_SUM.BOYS_PASS,
TR_SUM.BOYS_PASS_PERCENTAGE,
TR_SUM.GIRLS_APPEARED,
TR_SUM.GIRLS_PASS,
TR_SUM.GIRLS_PASS_PERCENTAGE,
TR_SUM.DIVISION_I_PERCENTAGE,
TR_SUM.DIVISION_II_PERCENTAGE,
TR_SUM.DIVISION_III_PERCENTAGE,
TR_SUM.RESULT_WITHHELD_WO,
TR_SUM.RESULT_WITHHELD_WT,
TR_SUM.RESULT_WITHHELD_WU,
TR_SUM.RESULT_WITHHELD_WE,
TR_SUM.RESULT_WITHHELD_WA,
TR_SUM.RESULT_WITHHELD_WG,
TR_SUM.FAILURE_DELETED,
TR_SUM.FAILURE_WITH_EXCEMPTION,
IF((RESULT='W' OR RESULT='T'),IF(WITHHELD_TYPE='W/E','W/E','W/T'),"") AS WW,
TPSD.RESULT,
TPSD.WITHHELD_TYPE,
TRM.TRSEMCODE,
TPT.`OBT_SEM1`,
TPT.`TOT_SEM1`,
TPT.`OBT_SEM2`,
TPT.`TOT_SEM2`,
TPT.`OBT_SEM3`,
TPT.`TOT_SEM3`,
TPT.`OBT_SEM4`,
TPT.`TOT_SEM4`,
TPT.`OBT_SEM5`,
TPT.`TOT_SEM5`,
TPT.`OBT_SEM6`,
TPT.`TOT_SEM6`,
TPT.`OBT_SEM7`,
TPT.`TOT_SEM7`,
TPT.`OBT_SEM8`,
TPT.`TOT_SEM8`,
TPT.`OBT_SEM9`,
TPT.`TOT_SEM9`,
TPT.`PER_SEM1`,
TPT.`PER_SEM2`,
TPT.`PER_SEM3`,
TPT.`PER_SEM4`,
TPT.`PER_SEM5`,
TPT.`PER_SEM6`,
TPT.`PER_SEM7`,
TPT.`PER_SEM8`,
TPT.`PER_SEM9`,
TPT.`PER_SEM10`,
        IFNULL(TPT.RESULT_SEM1,"") AS RESULT_SEM1,
	   IFNULL(TPT.RESULT_SEM2,"") AS RESULT_SEM2,
	   IFNULL(TPT.RESULT_SEM3,"") AS RESULT_SEM3,
	   IFNULL(TPT.RESULT_SEM4,"") AS RESULT_SEM4,
	  IFNULL(TPT.RESULT_SEM5,"") AS RESULT_SEM5,
	   IFNULL(TPT.RESULT_SEM6,"") AS RESULT_SEM6,
	   	  IFNULL(TPT.RESULT_SEM7,"") AS RESULT_SEM7,
	   IFNULL(TPT.RESULT_SEM8,"") AS RESULT_SEM8
FROM `SUBJECTBILANG_SGBAU`.`TRPRINTSTUDENTDETAILS` AS TPSD
INNER JOIN `SUBJECTBILANG_SGBAU`.`TRROOTMASTER` AS TRM
ON TPSD.TRCOURSECODE = TRM.TRCOURSECODE
AND TRM.deleted_at IS NULL
INNER JOIN UNI_SYSTEM_SGBAU.COURSESUBJECTCOUNT AS CSC
ON CSC.COURSECD=TRM.COURSECODE
AND CSC.SEMCODE=TRM.TRSEMCODE 
AND CSC.SESSCODE=TRM.SESSCODE
AND CSC.deleted_at IS NULL
INNER JOIN `SUBJECTBILANG_SGBAU`.`TRPRINTSTUDENTDETAILS_PART_EXTRA` AS TPSD_PE
ON TPSD.TRCOURSECODE = TPSD_PE.TRCOURSECODE
AND TPSD.STUDENTCODE = TPSD_PE.STUDENTCODE
AND TPSD_PE.deleted_at IS NULL
INNER JOIN `SUBJECTBILANG_SGBAU`.`TRPRINTSTUDENTDETAILS_TOTAL_EXTRA` AS TPSD_TE
ON TPSD.TRCOURSECODE = TPSD_TE.TRCOURSECODE
AND TPSD.STUDENTCODE = TPSD_TE.STUDENTCODE
AND TPSD_TE.deleted_at IS NULL
LEFT JOIN `SUBJECTBILANG_SGBAU`.`TRPRINTSTUDENTDETAILS_GRACE_EXTRA` AS GRC_E
ON TPSD.TRCOURSECODE = GRC_E.TRCOURSECODE
AND TPSD.STUDENTCODE = GRC_E.STUDENTCODE
AND GRC_E.deleted_at IS NULL
LEFT JOIN `SUBJECTBILANG_SGBAU`.`TRPRINTSTUDENTDETAILS_GRADE_EXTRA` AS GRD_E
ON TPSD.TRCOURSECODE = GRD_E.TRCOURSECODE
AND TPSD.STUDENTCODE = GRD_E.STUDENTCODE
AND GRD_E.deleted_at IS NULL
LEFT JOIN `UNI_SYSTEM_SGBAU`.`INCENTIVES` AS INC
ON TRM.COURSECODE = INC.COURSECD
AND TRM.TRSEMCODE = INC.SEMCODE
AND INC.SESSCODE = TRM.SESSCODE 
AND TPSD.STUDENTCODE = INC.STUDENTCODE

AND TPSD.FACUCOURSEDEGREECODE	 = INC.FACUCOURSEDEGREECODE
AND  INC.deleted_at IS NULL 
LEFT JOIN `SUBJECTBILANG_SGBAU`.`TRPASSOUTDATATABLE` AS TPT
ON TPSD.STUDENTCODE = TPT.STUDENTCODE
LEFT JOIN `UNI_SYSTEM_SGBAU`.`STOREPICK` AS SP
ON TPSD.RESULT = SP.PICK_ID
AND SP.STORE_ID = 'display_result_syntax' AND SP.deleted_at IS NULL
LEFT JOIN `SUBJECTBILANG_SGBAU`.`TRPRINTSTUDENT_ORESULT` AS TRO
ON TPSD.STUDENTCODE = TRO.STUDENTCODE
AND TPSD.TRCOURSECODE = TRO.TRCOURSECODE AND TRO.deleted_at IS NULL
LEFT JOIN `SUBJECTBILANG_SGBAU`.`TRPRINTSTUDENT_TOTALS` AS TPS_T
ON TPSD.STUDENTCODE = TPS_T.STUDENTCODE
AND TPSD.TRCOURSECODE = TPS_T.TRCOURSECODE
AND TPS_T.SUBJECTTAG='L'
LEFT JOIN `SUBJECTBILANG_SGBAU`.`TR_SUMMARY` AS TR_SUM
ON TRM.TRCOURSECODE = TR_SUM.TRCOURSECODE
AND TPSD.FACUCOURSEDEGREECODE = TR_SUM.FACUCOURSEDEGREECODE AND TR_SUM.deleted_at IS NULL
LEFT JOIN `UNI_SYSTEM_SGBAU`.`STUDENTAPPLICANTDATA` AS SA
ON SA.STUDENTCODE = TPSD.STUDENTCODE
LEFT JOIN `SUBJECTBILANG_SGBAU`.`DO_WITHHELD` AS WT
ON  WT.STUDENTCODE = TPSD.STUDENTCODE
AND WT.SEMCODE = TRM.TRSEMCODE
AND WT.SESSCODE = TRM.SESSCODE
WHERE TPSD.TRCOURSECODE =  $P{course_name} 
AND TRM.SESSCODE =  $P{SESSCODE} 
AND TRM.STUDENTTYPE=  $P{STUDENTTYPE} 
AND TRM.RESULTTYPE=  $P{RESULTTYPE} 
AND TPSD.INSTCODE =  $P{INSTCODE} 
AND TRM.RES_TYPE = 3
AND CSC.SYLLCODE = TRM.SYLLCODE

AND TPSD.deleted_at IS NULL
GROUP BY TPSD.TRCOURSECODE,TPSD.INSTCODE,TPSD.STUDENTCODE
ORDER BY TPSD.TRCOURSECODE,TPSD.INSTCODE,TPSD.EXAMROLLNUMBER]]>
	</queryString>
