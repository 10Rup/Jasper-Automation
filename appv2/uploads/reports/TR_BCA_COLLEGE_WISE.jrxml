CASE
WHEN TPSD_TE.ROW1_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN TPSD_TE.ROW1_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW1_XRESULT
END AS R1_XMP,
CASE
WHEN TPSD_TE.ROW2_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN TPSD_TE.ROW2_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW2_XRESULT
END AS R2_XMP,
CASE
WHEN TPSD_TE.ROW3_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN TPSD_TE.ROW3_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW3_XRESULT
END AS R3_XMP,
CASE
WHEN TPSD_TE.ROW4_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN TPSD_TE.ROW4_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW4_XRESULT
END AS R4_XMP,
CASE
WHEN TPSD_TE.ROW5_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN TPSD_TE.ROW5_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW5_XRESULT
END AS R5_XMP,
CASE
WHEN TPSD_TE.ROW6_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN TPSD_TE.ROW6_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW6_XRESULT
END AS R6_XMP,
CASE
WHEN  TPSD_TE.ROW7_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN  TPSD_TE.ROW7_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW7_XRESULT
END AS R7_XMP,
CASE
WHEN  TPSD_TE.ROW8_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN  TPSD_TE.ROW8_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW8_XRESULT
END AS R8_XMP,
CASE
WHEN  TPSD_TE.ROW9_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN  TPSD_TE.ROW9_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW9_XRESULT
END AS R9_XMP,
CASE
WHEN  TPSD_TE.ROW10_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN  TPSD_TE.ROW10_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW10_XRESULT
END AS R10_XMP,	
CASE
WHEN TPSD_TE.ROW11_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN TPSD_TE.ROW11_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW11_XRESULT
END AS R11_XMP,	
CASE
WHEN  TPSD_TE.ROW12_XRESULT ='XM.I,XM.P' THEN 'XM.P'
WHEN  TPSD_TE.ROW12_XRESULT ='XM.I' THEN ""
ELSE TPSD_TE.ROW12_XRESULT
END AS R12_XMP,

TRM.TOTALMARK,
TR_SUM.SUB_WISE_APPEARED,TR_SUM.SUB_WISE_PASS, TR_SUM.SUB_WISE_PER ,
TR_SUM.SUBJECTCODE,TR_SUM.SUBJECTUCODE,TR_SUM.SUBJECTNAME,
TR_SUM.TOT_APPEARED,
TR_SUM.TOT_PASS,
TR_SUM.TOT_PASS_PERCENTAGE,
TR_SUM.FRESH_APPEARED,
