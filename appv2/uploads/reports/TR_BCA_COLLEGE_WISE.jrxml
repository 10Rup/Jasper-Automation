(SELECT
ORESULT
FROM SUBJECTBILANG_SGBAU.TRPRINTSTUDENT_ORESULT
WHERE SUBJECTCODE = TPSD_TE.ROW7_SUBJECTCODE
AND STUDENTCODE = TPSD_TE.STUDENTCODE
AND TRCOURSECODE = TPSD_TE.TRCOURSECODE
LIMIT 1) AS RPE7,
(SELECT
ORESULT
FROM SUBJECTBILANG_SGBAU.TRPRINTSTUDENT_ORESULT
WHERE SUBJECTCODE = TPSD_TE.ROW8_SUBJECTCODE
AND STUDENTCODE = TPSD_TE.STUDENTCODE
AND TRCOURSECODE = TPSD_TE.TRCOURSECODE
LIMIT 1) AS RPE8,
(SELECT
ORESULT
FROM SUBJECTBILANG_SGBAU.TRPRINTSTUDENT_ORESULT
WHERE SUBJECTCODE = TPSD_TE.ROW9_SUBJECTCODE
AND STUDENTCODE = TPSD_TE.STUDENTCODE
AND TRCOURSECODE = TPSD_TE.TRCOURSECODE
LIMIT 1) AS RPE9,
(SELECT
ORESULT
FROM SUBJECTBILANG_SGBAU.TRPRINTSTUDENT_ORESULT
WHERE SUBJECTCODE = TPSD_TE.ROW10_SUBJECTCODE
AND STUDENTCODE = TPSD_TE.STUDENTCODE
AND TRCOURSECODE = TPSD_TE.TRCOURSECODE
LIMIT 1) AS RPE10,
(SELECT
ORESULT
FROM SUBJECTBILANG_SGBAU.TRPRINTSTUDENT_ORESULT
WHERE SUBJECTCODE = TPSD_TE.ROW11_SUBJECTCODE
AND STUDENTCODE = TPSD_TE.STUDENTCODE
AND TRCOURSECODE = TPSD_TE.TRCOURSECODE
LIMIT 1) AS RPE11,
(SELECT
ORESULT
FROM SUBJECTBILANG_SGBAU.TRPRINTSTUDENT_ORESULT
WHERE SUBJECTCODE = TPSD_TE.ROW12_SUBJECTCODE
AND STUDENTCODE = TPSD_TE.STUDENTCODE
AND TRCOURSECODE = TPSD_TE.TRCOURSECODE
