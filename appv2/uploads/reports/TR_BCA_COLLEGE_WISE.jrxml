	<parameter name="course_name" class="java.lang.String"/>
	<parameter name="s3path" class="java.lang.String"/>
	<parameter name="SESSCODE" class="java.lang.String"/>
	<parameter name="STUDENTTYPE" class="java.lang.String"/>
	<parameter name="RESULTTYPE" class="java.lang.String"/>
	<parameter name="INSTCODE" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
(IFNULL(TPT.`OBT_SEM1`,0)+
IFNULL(TPT.`OBT_SEM2`,0)+
IFNULL(TPT.`OBT_SEM3`,0)+
IFNULL(TPT.`OBT_SEM4`,0)+
IFNULL(TPT.`OBT_SEM5`,0)+
IFNULL(TPT.`OBT_SEM6`,0)+
IFNULL(TPT.`OBT_SEM7`,0)+
IFNULL(TPT.`OBT_SEM8`,0)) AS cum_total_obt,

(IFNULL(TPT.`TOT_SEM1`,0)+
IFNULL(TPT.`TOT_SEM2`,0)+
IFNULL(TPT.`TOT_SEM3`,0)+
IFNULL(TPT.`TOT_SEM4`,0)+
IFNULL(TPT.`TOT_SEM5`,0)+
IFNULL(TPT.`TOT_SEM6`,0)+
IFNULL(TPT.`TOT_SEM7`,0)+
IFNULL(TPT.`TOT_SEM8`,0)) AS cum_total_max,

TPT.CUM_TOTAL_OBTAINED, TPT.CUM_TOTAL_GRAND,
 IFNULL(SA.TRADE,"") AS TRADE,CSC.FINALSEM, TPSD.COURSE_DEVISION,IFNULL(WT.REMARK_CODE,"") AS REMARK_CODE ,
CASE
WHEN TPSD.RESULT ="W" AND (TPSD.WITHHELD_TYPE ='2' OR TPSD.WITHHELD_TYPE IS NULL OR TPSD.WITHHELD_TYPE="") THEN "W/T" 
#WHEN TPSD.REMARKSLINE ="W" AND TPSD.WITHHELD_TYPE="W/A" THEN "W/A"
WHEN TPSD.WITHHELD_TYPE = "D" AND (TPSD.RESULT ="D" OR TPSD.RESULT ="W")  THEN ""
WHEN TPSD.RESULT ="P" AND TPSD.REMARKSLINE ="W" AND TPSD.WITHHELD_TYPE="W/A1"   THEN "W/A"
WHEN TPSD.RESULT ="P" AND TPSD.REMARKSLINE ="W"   THEN TPSD.WITHHELD_TYPE
WHEN TPSD.RESULT IN("T","W") AND TPSD.WITHHELD_TYPE IN("W/T","2",NULL,"") THEN "W/T"    
WHEN TPSD.WITHHELD_TYPE IN("W/U") THEN "W/U"
WHEN TPSD.RESULT ="F"  AND TPSD.REMARKSLINE ="W" AND TPSD.WITHHELD_TYPE = "W/E"   THEN "W/E"
WHEN TPSD.RESULT ="F"  AND TPSD.REMARKSLINE ="W"  AND TPSD.WITHHELD_TYPE = "2"   THEN "W/T"
WHEN TPSD.RESULT ="T" AND TPSD.WITHHELD_TYPE="W/S1" THEN "W/T"
WHEN TPSD.RESULT ="F"  AND TPSD.REMARKSLINE ="W" AND TPSD.WITHHELD_TYPE != "D"   THEN ""
#WHEN TPSD.RESULT ="W" THEN TPSD.WITHHELD_TYPE
ELSE ""
END AS "WHT",

TRM.TRSEMCODE AS TRM_SESSCODE,
TRM.SESSCODE,
TPSD.REMARKSLINE,
TPSD.COURSE_SGPA,TRM.PUBLICATIONDATE,ifnull(STR_TO_DATE(TRM.PUBLICATIONDATE, '%m/%d/%Y'),"") as pub_data_time,
CSC.SEMCODE,
INC.INCENTIVE,
INC.USEINCENTIVE,
(INC.INCENTIVE-INC.USEINCENTIVE) AS REM_INC,
TPSD.INSTCODE,
TPSD.TRCOURSECODE,
TPSD.STUDENTCODE,
TPSD.EXAMROLLNUMBER,
TPSD.PARMANETROLLNUMBER,
TPSD.STUDENTNAME,
