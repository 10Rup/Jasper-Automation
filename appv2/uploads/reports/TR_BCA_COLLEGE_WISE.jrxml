TPSD.COURSE_CGPA          AS CGPA_F,
TPSD.TRCREDIT,
TRM.FOOTERLINE,
SP.PICK_TEXT              AS RESULT_S,
TPSD.MEDIUM,
TPSD.STUDENTSEX,
TPSD.GRACENEED,
TRM.STUDENTTYPE,
TPSD.STUDENTTYPE          AS STUDCAT,

