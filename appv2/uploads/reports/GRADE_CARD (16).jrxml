	<field name="OBT_SEM4" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="OBT_SEM4"/>
	</field>
	<field name="OBT_SEM5" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="OBT_SEM5"/>
	</field>
	<field name="OBT_SEM6" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="OBT_SEM6"/>
	</field>
	<field name="OBT_SEM7" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="OBT_SEM7"/>
	</field>
	<field name="OBT_SEM8" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="OBT_SEM8"/>
	</field>
