	<parameter name="course_name" class="java.lang.String"/>
	<parameter name="INSTCODE" class="java.lang.String"/>
	<parameter name="RESULTTYPE" class="java.lang.String"/>
	<parameter name="STUDENTTYPE" class="java.lang.String"/>
	<parameter name="s3path" class="java.lang.String"/>
	<parameter name="sem_code" class="java.lang.String"/>
	<parameter name="SESSCODE" class="java.lang.String"/>
	<parameter name="ROLLNO" class="java.lang.String"/>
	<parameter name="issue_date" class="java.lang.String"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
IFNULL(TPSD.WITHHELD_TYPE,"") AS WITHHELD_TYPE,TRM.STUDENTTYPE,
IF(CM.PASSOUTSEM = TRM.TRSEMCODE,1,0) AS FINALSEM,TPSD.TRCREDIT,
IFNULL(TP.RESULT_SEM1,"") AS RESULT_SEM1,
IFNULL(TP.RESULT_SEM2,"") AS RESULT_SEM2,
IFNULL(TP.RESULT_SEM3,"") AS RESULT_SEM3,
IFNULL(TP.RESULT_SEM4,"") AS RESULT_SEM4,
IFNULL(TP.RESULT_SEM5,"") AS RESULT_SEM5,
IFNULL(TP.RESULT_SEM6,"") AS RESULT_SEM6,
IFNULL(TP.RESULT_SEM7,"") AS RESULT_SEM7,
IFNULL(TP.RESULT_SEM8,"") AS RESULT_SEM8,


IFNULL(TP.OBT_SEM1,"") AS OBT_SEM1,
IFNULL(TP.OBT_SEM2,"") AS OBT_SEM2,
IFNULL(TP.OBT_SEM3,"") AS OBT_SEM3,
IFNULL(TP.OBT_SEM4,"") AS OBT_SEM4,
IFNULL(TP.OBT_SEM5,"") AS OBT_SEM5,
IFNULL(TP.OBT_SEM6,"") AS OBT_SEM6,
IFNULL(TP.OBT_SEM7,"") AS OBT_SEM7,
IFNULL(TP.OBT_SEM8,"") AS OBT_SEM8,


IFNULL(TP.TOT_SEM1,"") AS TOT_SEM1,
IFNULL(TP.TOT_SEM2,"") AS TOT_SEM2,
IFNULL(TP.TOT_SEM3,"") AS TOT_SEM3,
IFNULL(TP.TOT_SEM4,"") AS TOT_SEM4,
IFNULL(TP.TOT_SEM5,"") AS TOT_SEM5,
IFNULL(TP.TOT_SEM6,"") AS TOT_SEM6,
IFNULL(TP.TOT_SEM7,"") AS TOT_SEM7,
IFNULL(TP.TOT_SEM8,"") AS TOT_SEM8,

IFNULL(TP.CRDT_SEM1,"") AS CRDT_SEM1,
IFNULL(TP.CRDT_SEM2,"") AS CRDT_SEM2,
IFNULL(TP.CRDT_SEM3,"") AS CRDT_SEM3,
IFNULL(TP.CRDT_SEM4,"") AS CRDT_SEM4,
IFNULL(TP.CRDT_SEM5,"") AS CRDT_SEM5,
IFNULL(TP.CRDT_SEM6,"") AS CRDT_SEM6,
IFNULL(TP.CRDT_SEM7,"") AS CRDT_SEM7,
IFNULL(TP.CRDT_SEM8,"") AS CRDT_SEM8,


IFNULL(TP.SGPA_SEM1,"") AS SGPA_SEM1,
IFNULL(TP.SGPA_SEM2,"") AS SGPA_SEM2,
IFNULL(TP.SGPA_SEM3,"") AS SGPA_SEM3,
IFNULL(TP.SGPA_SEM4,"") AS SGPA_SEM4,
IFNULL(TP.SGPA_SEM5,"") AS SGPA_SEM5,
IFNULL(TP.SGPA_SEM6,"") AS SGPA_SEM6,
IFNULL(TP.SGPA_SEM7,"") AS SGPA_SEM7,
IFNULL(TP.SGPA_SEM8,"") AS SGPA_SEM8,

IFNULL(TP.STTYPE_SEM1,"") AS STTYPE_SEM1,
IFNULL(TP.STTYPE_SEM2,"") AS STTYPE_SEM2,
IFNULL(TP.STTYPE_SEM3,"") AS STTYPE_SEM3,
IFNULL(TP.STTYPE_SEM4,"") AS STTYPE_SEM4,
IFNULL(TP.STTYPE_SEM5,"") AS STTYPE_SEM5,
IFNULL(TP.STTYPE_SEM6,"") AS STTYPE_SEM6,
IFNULL(TP.STTYPE_SEM7,"") AS STTYPE_SEM7,
IFNULL(TP.STTYPE_SEM8,"") AS STTYPE_SEM8,

(IFNULL(TP.TOT_SEM1,"")+
IFNULL(TP.TOT_SEM2,"")+
IFNULL(TP.TOT_SEM3,"")+
IFNULL(TP.TOT_SEM4,"")+
IFNULL(TP.TOT_SEM5,"")+
IFNULL(TP.TOT_SEM6,"")+
IFNULL(TP.TOT_SEM7,"")+
IFNULL(TP.TOT_SEM8,"")) AS FINAL_TOT,

(IFNULL(TP.OBT_SEM1,"")+
IFNULL(TP.OBT_SEM2,"")+
IFNULL(TP.OBT_SEM3,"")+
IFNULL(TP.OBT_SEM4,"")+
IFNULL(TP.OBT_SEM5,"")+
IFNULL(TP.OBT_SEM6,"")+
IFNULL(TP.OBT_SEM7,"")+
IFNULL(TP.OBT_SEM8,"")) AS FINAL_OBT,
CASE
WHEN TRSEMCODE IN ("SM02","YR02") AND CM.PASSOUTSEM = TRM.TRSEMCODE AND TP.RESULT_SEM1="P" AND TPSD.RESULT="P" THEN "PASS" 
WHEN TRSEMCODE IN ("SM04","YR04") AND CM.PASSOUTSEM = TRM.TRSEMCODE AND TP.RESULT_SEM1="P" AND TP.RESULT_SEM2="P" AND TP.RESULT_SEM3="P" AND TPSD.RESULT="P" THEN "PASS" 
WHEN TRSEMCODE IN ("SM06") AND CM.PASSOUTSEM = TRM.TRSEMCODE AND TP.RESULT_SEM1="P" AND TP.RESULT_SEM2="P" AND TP.RESULT_SEM3="P" AND TP.RESULT_SEM4="P" AND TP.RESULT_SEM5="P" AND TPSD.RESULT="P" THEN "PASS" 
WHEN TRSEMCODE IN ("SM08") AND CM.PASSOUTSEM = TRM.TRSEMCODE AND TP.RESULT_SEM1="P" AND TP.RESULT_SEM2="P" AND TP.RESULT_SEM3="P" AND TP.RESULT_SEM4="P" AND TP.RESULT_SEM5="P" AND TP.RESULT_SEM6="P" AND TP.RESULT_SEM7="P" AND TPSD.RESULT="P" THEN "PASS" 
ELSE "FAIL"
END AS FINAL_RES,

#(SELECT IF(CM.PASSOUTSEM = TRM.TRSEMCODE AND FINAL_RES="PASS",
#CAST((FINAL_OBT/FINAL_TOT)*100  AS DECIMAL(8,2)),"")) AS FINAL_PER,
IFNULL(TP.show_cgpa,"") AS FINAL_PER,
TP.FINAL_DIV,IFNULL(TP.CGPA,"") AS CGPA_PER,

TR_R.SUBJECTCODE,V.DISABLITY_TYPE, TRM.GRADE_LOGIC,IFNULL(SM.SUBJECTCATEGORY,"0") AS SUBJECTCATEGORY,
SEM.SEMTAGG,TRM.SUBHEADER,SUM(IF(TR_R.TYPE="T" AND TR_R.CTOTAL IN ("AB","AA"),1,0)) AS AB_SUB,V.ABC_ID,V.MAJOR_PAPER,
CM.COURSEDISPLAYTYPE,DATE_FORMAT(STR_TO_DATE(TRM.PUBLICATIONDATE, '%m/%d/%Y'), '%d-%m-%Y') AS d,DATE_FORMAT(STR_TO_DATE(TRM.PUBLICATIONDATE, '%m/%d/%Y'), '%D %M, %Y') AS PUBLICATIONDATE,
 DPT.DIPARTMENTSNAME,TPSD.TRCOURSECODE,TPSD.STUDENTCODE,TRM.COURSECODE,TRM.SESSCODE,TRM.TRSEMCODE, SEM.SEMESTER, TPSD.TRCREDIT,TPSD.STUDENTCODE, V.GURDIANSRES_PS, V.ROLLNO,TPSD.EXAMROLLNUMBER, SBM.SUBQCODE, SBM.SUBJDECS, V. DIPARTMENTNAME, V.YEAROFADMISION, TPSD.COURSETOTALCREDIT,TPSD.TRCOURSECODE,TPSD.EXAMROLLNUMBER,TPSD.PARMANETROLLNUMBER,TPSD.STUDENTNAME,TPSD.COURSENAME,CM.COURSESNAME AS StreamCode,
TPSD.RESULT,TR_R.SRESULT,TPSD.COLLEGECODE,TPSD.COLLEGENAME,TR_R.CTOTAL,TR_R.GRACE,CAST(TR_R.CREDIT AS UNSIGNED) AS CREDIT_INT,CAST(TR_R.CRPOINT AS UNSIGNED) AS CR_POINT,TR_R.AGE ,
CAST(TR_R.AGE AS UNSIGNED) AS GRADE_POINT,SBM.SUBJTYPE,TPSD.MCNUMBER,TPSD.MCNUMBERSERIES,TR_R.TYPE,
IF(TR_R.CTOTAL="XX","XX",(IF(TR_R.CTOTAL="AB","AB",(TR_R.CTOTAL+TR_R.GRACE)))) AS MARK_SEC,TR_R.CMAXMARK,TR_R.GRADE,
IFNULL(CTSS.CREDIT,"0") AS CREDIT,TR_R.CRPOINT,TR_R.AGE,TR_R.STOTAL,TR_R.TOTAL,CAST(TPSD.COURSE_SGPA AS DECIMAL(8,2)) AS GPA,
TPSD.THEOTOTAL,TPSD.TOTAL AS GRAND_TOT,TPSD.GTOTAL AS GRAND_TOT_MAX,TPSD.THEOOBT,SBM.COURSECODE,SBM.SUBJDECS,SBM.SUBJECTPARTCODE,SBM.SUBJDECS,SBM.SUBJECTUCODE,
STP.PICK_TEXT AS FINAL_RESULT,
CAST(TPSD.COURSE_SGPA AS DECIMAL(8,2)) AS SGPA,IFNULL(MR.SUBJECTCODE,"") AS REPEATER_SUB,
(SELECT COUNT(TRR.SUBJECTCODE) FROM `SUBJECTBILANG_MZU`.`TRPRINTSTUDENT_ROWS` AS TRR
INNER JOIN `SUBJECTBILANG_MZU`.`SUBJECTMSTEVENSEM_PART` AS SBM 
ON TRR.SUBJECTCODE = SBM.SUBJECTCODE
WHERE SBM.COURSECODE=TRM.COURSECODE
AND TRR.STUDENTCODE =TR_R.STUDENTCODE
AND SBM.SEMCODE=TRM.TRSEMCODE
AND SBM.TYPE ="T"
 AND TRR.TYPE = SBM.TYPE AND TRR.UNIT = SBM.UNIT) AS THEORY_COUNT,
   CONCAT('https://',$P{s3path},PS.STUDENTPHOTOPATH)  AS SPHOTO,
       CONCAT('https://',$P{s3path},PS.STUDENTSIGNATUREPATH)  AS SIG,
(SELECT COUNT(TRR.SUBJECTCODE) FROM `SUBJECTBILANG_MZU`.`TRPRINTSTUDENT_ROWS` AS TRR
INNER JOIN `SUBJECTBILANG_MZU`.`SUBJECTMSTEVENSEM_PART` AS SBM 
ON TRR.SUBJECTCODE = SBM.SUBJECTCODE
WHERE SBM.COURSECODE=TRM.COURSECODE
AND TRR.STUDENTCODE =TR_R.STUDENTCODE
AND SBM.SEMCODE=TRM.TRSEMCODE
AND SBM.TYPE ="P"
 AND TRR.TYPE = SBM.TYPE AND TRR.UNIT = SBM.UNIT)AS PRAC_COUNT,

((SELECT COUNT(TRR.SUBJECTCODE) FROM `SUBJECTBILANG_MZU`.`TRPRINTSTUDENT_ROWS` AS TRR
INNER JOIN `SUBJECTBILANG_MZU`.`SUBJECTMSTEVENSEM_PART` AS SBM 
ON TRR.SUBJECTCODE = SBM.SUBJECTCODE
WHERE SBM.COURSECODE=TRM.COURSECODE
AND TRR.STUDENTCODE =TR_R.STUDENTCODE
AND SBM.SEMCODE=TRM.TRSEMCODE
AND SBM.TYPE ="T"
 AND TRR.TYPE = SBM.TYPE AND TRR.UNIT = SBM.UNIT)-
 (SELECT COUNT(TRR.SUBJECTCODE) FROM `SUBJECTBILANG_MZU`.`TRPRINTSTUDENT_ROWS` AS TRR
INNER JOIN `SUBJECTBILANG_MZU`.`SUBJECTMSTEVENSEM_PART` AS SBM 
ON TRR.SUBJECTCODE = SBM.SUBJECTCODE
WHERE SBM.COURSECODE=TRM.COURSECODE
AND TRR.STUDENTCODE =TR_R.STUDENTCODE
AND SBM.SEMCODE=TRM.TRSEMCODE
AND SBM.TYPE ="S"
 AND TRR.TYPE = SBM.TYPE AND TRR.UNIT = SBM.UNIT))AS SESS_COUNT,
TRMP.PUBLICATIONDATE AS PUB_DT,
IF($P{issue_date}!="NA",DATE_FORMAT( $P{issue_date} , '%D %M, %Y'),DATE_FORMAT(TRMP.PUBLICATIONDATE,'%D %M, %Y')) AS issue_dt,
IF(SBM.SUBQCODE = "C13 (VI)", "C13 (VI)", IF(SBM.SUBQCODE = "C13 (HI)", "C13 (HI)", "")) AS kk,
VAC.`Name_of_Course_Under_SEC`,VAC.`Paper_code`,
SEC.`Name_of_Course_Under_SEC` AS SECpap,SEC.`Paper_code` AS SECcode,
TRM.SUBHEADER AS EXAM,TRM.FOOTERLINE AS Decr, TRM.TRCOURSENAME,IM.INSTSNAME,IM.INSTNAME,IM.CITY,SEM.SEMNAME,SEM.SEMDISPNAME,SBM.SUBJTYPE,SEM.NUMERIC

FROM `SUBJECTBILANG_MZU`.`TRPRINTSTUDENTDETAILS` AS TPSD

JOIN `SUBJECTBILANG_MZU`.`TRPRINTSTUDENT_ROWS` AS TR_R ON TPSD.STUDENTCODE = TR_R.STUDENTCODE AND TR_R.DELETED_AT IS NULL
AND TPSD.TRCOURSECODE = TR_R.TRCOURSECODE
JOIN `UNI_SYS_MZU`.`STOREPICK` AS STP 
ON TPSD.RESULT = STP.PICK_ID
AND STP.STORE_ID='display_result_syntax'

JOIN `UNI_SYS_MZU`.`VIEW_STUDENTENROLLED` AS V ON TPSD.STUDENTCODE = V.STUDENTCODE AND TPSD.FACUCOURSEDEGREECODE = V.FACUCOURSEDEGREECODE

JOIN `SUBJECTBILANG_MZU`.`TRROOTMASTER` AS TRM ON TPSD.TRCOURSECODE = TRM.TRCOURSECODE
AND TR_R.TRCOURSECODE = TRM.TRCOURSECODE
AND TRM.DELETED_AT IS NULL

JOIN `SUBJECTBILANG_MZU`.`TRROOTMASTER_PART` AS TRMP ON TRM.id=TRMP.tr_id

INNER JOIN  `SUBJECTBILANG_MZU`.`COURSE_TYPE_SUBJECT_SCHEMA` AS CTSS
ON CTSS.SUBJECTCODE = TR_R.SUBJECTCODE
AND CTSS.COURSECODE = TRM.COURSECODE
AND CTSS.SEMECODE =TRM.TRSEMCODE
AND CTSS.`deleted_at` IS NULL

LEFT JOIN  `SUBJECTBILANG_MZU`.`STUDENTPAPER_GRP_DETAILS_TMP` AS SPM
ON SPM.STUDENTCODE = TPSD.STUDENTCODE
AND SPM.SUBJECTCODE  = TR_R.SUBJECTCODE	

INNER JOIN `UNI_SYS_MZU`.`INSTMST` AS IM ON TPSD.INSTCODE = IM.INSTCODE

INNER JOIN `UNI_SYS_MZU`.`SEMESTERMST` AS SEM ON TR_R.SEMCODE = SEM.SEMCODE

INNER JOIN `SUBJECTBILANG_MZU`.`SUBJECTMSTEVENSEM_PART` AS SBM 
ON TRM.COURSECODE = SBM.COURSECODE 
AND TR_R.SUBJECTCODE = SBM.SUBJECTCODE
AND TR_R.TYPE = SBM.TYPE AND TR_R.UNIT = SBM.UNIT

INNER JOIN `SUBJECTBILANG_MZU`.`SUBJECTMSTEVENSEM` AS SM 
ON TR_R.SUBJECTCODE = SM.SUBJECTCODE


INNER JOIN `UNI_SYS_MZU`.`COURSEMST` AS CM ON TRM.COURSECODE=CM.COURSECD


LEFT JOIN SUBJECTBILANG_MZU.MBBS_REPETR AS MR 
ON MR.STUDENTCODE = TPSD.STUDENTCODE
AND MR.FACUCOURSEDEGREECODE = TPSD.FACUCOURSEDEGREECODE 
AND MR.`SUBJECTCODE`= TR_R.`SUBJECTCODE` 
AND MR.SESSCODE = TRM.SESSCODE 
AND MR.SEMCODE = TRM.TRSEMCODE 
AND MR.STUDENTTYPE ='D' 
#AND MR.RESULTTYPE =TRM.RESULTTYPE 

   LEFT JOIN `UNI_SYS_MZU`.`STUDENTPHOTOSIGN` AS PS
          ON TPSD.STUDENTCODE = PS.STUDENTCODE
          
LEFT JOIN `UNI_SYS_MZU`.`DIPARTMENTMST` AS DPT
ON  V.DIPARTMENTCODE = DPT.DIPARTMENTCODE

LEFT JOIN `SUBJECTBILANG_MZU`.`TRPASSOUTDATATABLE` AS TP
ON TP.ROLL_NO = TPSD.EXAMROLLNUMBER

LEFT JOIN `SUBJECTBILANG_MZU`.`MZU_SEC_VAC120` AS VAC
ON TPSD.`EXAMROLLNUMBER`=VAC.`Roll_No`
AND TRM.SESSCODE=  VAC.`sesscode`
AND TRM.TRSEMCODE= VAC.`semester`
AND VAC.`Paper_code`="VAC120"

LEFT JOIN `SUBJECTBILANG_MZU`.`MZU_SEC_VAC120` AS SEC
ON TPSD.`EXAMROLLNUMBER`=SEC.`Roll_No`
AND TRM.SESSCODE=  SEC.`sesscode`
AND TRM.TRSEMCODE= SEC.`semester`
AND SEC.`Paper_code`="SEC"


WHERE TRM.COURSECODE =  $P{course_name} 
AND TRM.SESSCODE= $P{SESSCODE}  
AND TRM.TRSEMCODE=   $P{sem_code}
AND TRM.RESULTTYPE =  $P{RESULTTYPE} 
AND TRM.STUDENTTYPE = $P{STUDENTTYPE} 
AND IF("1" =  $P{INSTCODE}  ,TPSD.INSTCODE !="",TPSD.INSTCODE= $P{INSTCODE} )
 AND IF("NA" =  $P{ROLLNO}  ,TPSD.EXAMROLLNUMBER !="",TPSD.EXAMROLLNUMBER= $P{ROLLNO} )
#AND  TPSD.RESULT IN ("V","U","W","T") 
AND (SBM.UNITNAME!="" OR SBM.UNITNAME IS NOT NULL) 
#AND TRM.MARKSCARD='BARCH_Gradesheet'
AND TPSD.deleted_at IS NULL
GROUP BY TRM.COURSECODE,TPSD.INSTCODE,TR_R.SEMCODE,TR_R.STUDENTCODE,TR_R.SUBJECTCODE
ORDER BY V.ROLLNO,TPSD.STUDENTNAME,SM.SUBJECTCATEGORY,SPM.SEQUENCE,FIELD(SBM.`TYPE`,"T","P","S"),SBM.SUBJECTCODE]]>
	</queryString>
	<field name="WITHHELD_TYPE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="WITHHELD_TYPE"/>
	</field>
	<field name="STUDENTTYPE" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="STUDENTTYPE"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TRROOTMASTER"/>
	</field>
	<field name="FINALSEM" class="java.lang.Long">
		<property name="com.jaspersoft.studio.field.label" value="FINALSEM"/>
	</field>
	<field name="TRCREDIT" class="java.lang.Double">
		<property name="com.jaspersoft.studio.field.label" value="TRCREDIT"/>
		<property name="com.jaspersoft.studio.field.tree.path" value="TRPRINTSTUDENTDETAILS"/>
	</field>
	<field name="RESULT_SEM1" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="RESULT_SEM1"/>
	</field>
	<field name="RESULT_SEM2" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="RESULT_SEM2"/>
	</field>
	<field name="RESULT_SEM3" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="RESULT_SEM3"/>
