		<property name="com.jaspersoft.studio.field.label" value="CRDT_SEM1"/>
	</field>
	<field name="CRDT_SEM2" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="CRDT_SEM2"/>
	</field>
	<field name="CRDT_SEM3" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="CRDT_SEM3"/>
	</field>
	<field name="CRDT_SEM4" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="CRDT_SEM4"/>
	</field>
	<field name="CRDT_SEM5" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="CRDT_SEM5"/>
	</field>
	<field name="CRDT_SEM6" class="java.lang.String">
