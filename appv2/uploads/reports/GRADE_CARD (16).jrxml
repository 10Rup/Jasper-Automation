		<property name="com.jaspersoft.studio.field.label" value="RESULT_SEM7"/>
	</field>
	<field name="RESULT_SEM8" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="RESULT_SEM8"/>
	</field>
	<field name="OBT_SEM1" class="java.lang.String">
		<property name="com.jaspersoft.studio.field.label" value="OBT_SEM1"/>
