<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1a3ec0e9-a736-460b-81a4-fa0e06798b78">
<queryString>
		<![CDATA[WITH MAIN AS (SELECT 
IFNULL(NAD.ABSENTSTUDENTCODE RLIKE SAD.STUDENTCODE,0) AS AB,SAD.STUDENTCODE,VF.INSTCODE,
ND.ID,ND.COURSECD,ND.SEMCODE,ND.SESSCODE,ND.SYLLCODE,JS.FILE_NAME,NAD.BATCH_SERIAL,NAD.BATCHNO,ND.DIPARTMENTCODE,
NA.ALLOTTED_VENUE,VF.INSTSNAME AS COLLEGECODE,VF.INSTNAME AS COLLEGENAME,
REGEXP_REPLACE(TRIM(UPPER(CONCAT(IFNULL(`SAD`.`STUDENTFNAME`,"")," ",IFNULL(`SAD`.`STUDENTMNAME`,"")," ",IFNULL(`SAD`.`STUDENTLNAME`,"")))), '\\s+', SPACE(1)) AS STUDENTNAME,
NP.PROGRAMNO,
ND.EXAM_NAME AS REPORT_HEADER,SRD.`ROLLNO`,SAD.`GURDIANSRES_PS` AS REGNO,SRD.YEAROFADMISION,
CT.SUBJECTCODE,CT.SUBJECTNAME,CT.SUBJECTUCODE,NP.MODULE,SMP.UNIT,SMP.TYPE,SMP.MARKS AS FULLMARK,

VF.COURSENAME,VF.COURSESHORTNAME,
SEM.SEMNAME,SEM.SEMESTER,SES.SESSDISPNAME AS SESION,
SPM_P.OTHER_REMARK,SPM_P.SESSIONALMARKS,SPM_P.IS_LOCK,
IF(IFNULL(SPM_P.OTHER_REMARK,"") != "",SPM_P.OTHER_REMARK,IF(SPM_P.IS_LOCK=2,SPM_P.SESSIONALMARKS,"")) AS OBT_MARKS


FROM `UNI_SYS_CUPG`.NOTICE_DETAILS AS ND

INNER JOIN `UNI_SYS_CUPG`.NOTICE_PROGRAMME  AS NP
ON NP.`NOTICE_ID` = ND.`id`
AND NP.`deleted_at` IS NULL


INNER JOIN `UNI_SYS_CUPG`.NOTICE_ALLOTMENT AS NA
ON NA.NOTICE_ID = ND.ID
AND NA.PROGRAMME_ID = NP.ID
AND NA.`deleted_at` IS NULL

INNER JOIN `UNI_SYS_CUPG`.NOTICE_ALLOTMENT_BATCH AS NAD 
ON NAD.NOTICE_ID = ND.ID
AND NAD.NOTICE_ALLOTMENT_ID = NA.ID

INNER JOIN `UNI_SYS_CUPG`.`STUDENTROLLDATA` AS SRD  
ON NAD.STUDENTCODE RLIKE SRD.STUDENTCODE

INNER JOIN `UNI_SYS_CUPG`.`STUDENTAPPLICANTDATA` AS SAD  
ON SAD.STUDENTCODE = SRD.STUDENTCODE

INNER JOIN  `UNI_SYS_CUPG`.`exam_form_details` AS EFD
ON  EFD.STUDENTCODE = SAD.STUDENTCODE
AND EFD.SESSCODE = ND.SESSCODE
AND EFD.SEMCODE = ND.SEMCODE
AND EFD.FORM_STATUS = 55
AND EFD.`exam_type` IN ("EXAMFORM","RE-APPEAR")
AND EFD.STUDENTTYPE= ND.EXAMTYPE
AND EFD.SYLLCODE = ND.SYLLCODE 
AND EFD.DELETED_AT IS NULL

INNER JOIN `UNI_SYS_CUPG`.`VIEW_FACUCOURSEDEGREEMST` AS VF
ON VF.`FACUCOURSEDEGREECODE` = EFD.FCD

INNER JOIN `SUBBILANG_CUPG`.`COURSE_TYPE_SUBJECT_SCHEMA` AS CT
ON CT.SUBJECTCODE = NP.SUBJECTCODE
AND CT.COURSECODE = ND.COURSECD
AND CT.DELETED_AT IS NULL

INNER JOIN `SUBBILANG_CUPG`.`SUBJECTMSTEVENSEM_PART` AS SMP
ON SMP.SUBJECTCODE = CT.SUBJECTCODE
AND SMP.COURSECODE = ND.COURSECD
AND SMP.TYPE="S"
AND SMP.DELETED_AT IS NULL

INNER JOIN `UNI_SYS_CUPG`.`SEMESTERMST` AS SEM
ON SEM.SEMCODE = ND.SEMCODE

INNER JOIN `UNI_SYS_CUPG`.`SESSIONMST` AS SES
ON SES.SESSCODE = ND.SESSCODE


LEFT JOIN `UNI_SYS_CUPG`.`STUDENTPAPERMAPPING_PART_DETAILS` AS SPM_P
ON SPM_P.`STUDENTCODE`= EFD.STUDENTCODE
AND SPM_P.`FACUCOURSEDEGREECODE`= EFD.FCD
AND SPM_P.`SUBJECTCODE`= SMP.SUBJECTCODE
AND SPM_P.`SYLLCODE`= EFD.SYLLCODE
AND SPM_P.`SESSCODE`= EFD.SESSCODE
AND SPM_P.`SEMCODE`= EFD.SEMCODE
AND SPM_P.`SEMTYPE`= EFD.STUDENTTYPE
AND SPM_P.UNIT = SMP.UNIT
AND SPM_P.TYPE = SMP.TYPE
AND SPM_P.deleted_at IS NULL

LEFT JOIN `UNI_SYS_CUPG`.`jasper_settings` AS JS
ON JS.ID =  'VALUE'   

WHERE ND.ID=  'VALUE' 
AND VF.INSTCODE in ( 'VALUE' )
AND NAD.FREEZE = 1
)

SELECT * FROM MAIN
#WHERE AB=0
ORDER BY COLLEGECODE,SUBJECTUCODE,MAIN.TYPE,UNIT,ROLLNO,BATCH_SERIAL]]>
	</queryString>
