<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1a3ec0e9-a736-460b-81a4-fa0e06798b78">
<queryString>
		<![CDATA[SELECT
 ER.APPLICATION_ID,
UPPER(EA.STUDENTFNAME) AS STUDENTFNAME,UPPER(EA.STUDENTMNAME) AS  STUDENTMNAME,UPPER(EA.STUDENTLNAME) AS STUDENTLNAME,
UPPER(EA.FATHERSNAME) AS FATHERSNAME, UPPER(EA.MOTHERSNAME) AS MOTHERSNAME,
  ER.EXM_GROUP,
ER.ROLL_NO,
  DT.PICK_TEXT 'DATE',
  TM.PICK_TEXT 'Reporting_TIME',
  TM.PICK_TEXT_EXTEND 'EXAM TIME',
 
CONCAT('https://ucanapplym.s3.amazonaws.com/',PIC.STUDENTPHOTOPATH) AS STUDENTPHOTOPATH ,

  CONCAT('https://ucanapplym.s3.amazonaws.com/',PIC.STUDENTSIGNATUREPATH) AS STUDENTSIGNATUREPATH,
  

  CR.ROOM_NAME AS Centre_Name,
  ER.ROOM_CODE AS CENTRE_CODE,
  CR.ADDRESS AS Centre_Address,
REPLACE(ROOM_CODE_bkup,"R","") AS ROOMNO

FROM UCANAPPLY_LARAVEL.ENTRANCE_ROLLNO AS ER
JOIN UCANAPPLY_LARAVEL.ENTRANCEAPPLICANTDATA AS EA ON ER.REGISTRATION_ID = EA.REGISTRATION_ID AND ER.COURSE_ID=EA.COURSE_ID
JOIN UCANAPPLY_LARAVEL.ENTRANCEPHOTOSIGN AS PIC ON PIC.REGISTRATION_ID=ER.REGISTRATION_ID
 JOIN UCANAPPLY_LARAVEL.EXAMCENTREROOM AS CR ON CR.ROOMCODE = ER.ROOM_CODE   AND CR.PORTALINSTYEARCODE = 'PIY0000032'
 LEFT JOIN UCANAPPLY_LARAVEL.STOREPICK DT ON DT.PICK_ID=ER.EXM_DATE AND DT.STORE_ID='EXM_DATE' AND DT.PORTALINSTYEARCODE='PIY0000032'
LEFT JOIN UCANAPPLY_LARAVEL.STOREPICK TM ON TM.PICK_ID=ER.EXM_TIME AND TM.STORE_ID='EXM_TIME' AND TM.PORTALINSTYEARCODE='PIY0000032'


WHERE ER.PORTALINSTYEARCODE = 'PIY0000032' AND ER.CENTRE_CHANGED='0'
#AND ER.BIKANER_DISTRICT = 
AND CR.EXAMCENTREID=   'VALUE' 
AND ER.ROOM_CODE IN ('VALUE')
ORDER BY ROOM_CODE,ROOM_CODE_bkup,ER.ROLL_NO;]]>
	</queryString>
