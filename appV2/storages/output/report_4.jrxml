<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="Blank_A4" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="1a3ec0e9-a736-460b-81a4-fa0e06798b78">
<queryString>
		<![CDATA[ SELECT DATE_FORMAT(CONVERT_TZ(NOW(),"-05:30","+00:00"),"%d/%m/%Y %r") AS printdate,i.logo,i.name AS 'institute name',tt.fullname,u.username,tt.address,u.email,
tt.bank_name,tt.bank_branch_name,tt.bank_account_no,tt.bank_ifsc_code,tt.mobile,em.exam_name,'2025' AS "YEAR",
CONCAT(ss.subqcode, '(', ss.subject_name, ')') AS subject_name,b.branch_name,COUNT(*) AS "total evaluated script"
    FROM CODE_GENERATION cc
    JOIN dbs_scan dd ON dd.code_gen_id=cc.id
    JOIN users u ON u.id=dd.evaluated_by
    JOIN teacher_master tt ON tt.user_id=u.id
    JOIN institute_master i ON i.id = u.inst_id
    JOIN subjects ss ON ss.id=cc.SUBQCODE
    JOIN branch b ON b.id = ss.branch_id
    JOIN exam_master em ON em.id=dd.exam_type
    WHERE dd.exam_type=examtype AND cc.INSTCODE=instid AND ss.id=subjectid AND dd.problem_script IS NULL
    AND u.id = userid AND dd.locked_time IS NOT NULL
    GROUP BY dd.evaluated_by;]]>
	</queryString>
